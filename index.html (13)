  // ---- Smooth swipe between main tabs ----
  (function initTabSwipe() {
    const pages = ['pageChats', 'pageHome', 'pageVoice', 'pageProfile'];
    const body = document.querySelector('.app-body');
    if (!body) return;
    let sx = 0, sy = 0, tracking = false, axis = null;
    let curIdx = 0;

    function activeIndex() {
      const activeBtn = document.querySelector('.nav-btn.active');
      if (!activeBtn) return 0;
      const i = pages.indexOf(activeBtn.dataset.page);
      return i < 0 ? 0 : i;
    }
    function goTo(idx, animate) {
      idx = Math.max(0, Math.min(pages.length - 1, idx));
      const target = pages[idx];
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.page === target));
      document.querySelectorAll('.tab-page').forEach(p => {
        p.classList.toggle('active', p.id === target);
        p.style.transition = '';
        p.style.transform = '';
      });
      if (target === 'pageChats') refreshChatList();
      if (target === 'pageVoice' && typeof refreshVoiceList === 'function') refreshVoiceList();
      if (target === 'pageProfile' && typeof renderProfile === 'function') renderProfile();
      curIdx = idx;
    }

    body.addEventListener('touchstart', (e) => {
      if (!document.getElementById('screenApp').classList.contains('active')) return;
      const t = e.touches[0];
      sx = t.clientX; sy = t.clientY; tracking = true; axis = null;
      curIdx = activeIndex();
    }, { passive: true });

    body.addEventListener('touchmove', (e) => {
      if (!tracking) return;
      const t = e.touches[0];
      const dx = t.clientX - sx;
      const dy = t.clientY - sy;
      if (axis === null) {
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        axis = Math.abs(dx) > Math.abs(dy) * 1.1 ? 'x' : 'y';
      }
      if (axis !== 'x') return;
      // live drag preview
      const w = body.clientWidth || 1;
      let offset = dx;
      // resistance at edges
      if ((curIdx === 0 && dx > 0) || (curIdx === pages.length - 1 && dx < 0)) offset = dx * 0.35;
      const curPage = document.getElementById(pages[curIdx]);
      if (curPage) {
        curPage.style.transition = 'none';
        curPage.style.transform = 'translateX(' + offset + 'px)';
      }
      // show neighbor
      const nextIdx = dx < 0 ? curIdx + 1 : curIdx - 1;
      if (nextIdx >= 0 && nextIdx < pages.length) {
        const nextPage = document.getElementById(pages[nextIdx]);
        if (nextPage) {
          nextPage.classList.add('active');
          nextPage.style.transition = 'none';
          const shift = dx < 0 ? (w + offset) : (-w + offset);
          nextPage.style.transform = 'translateX(' + shift + 'px)';
          // hide others
          pages.forEach((id, i) => {
            if (i !== curIdx && i !== nextIdx) {
              const el = document.getElementById(id);
              if (el) { el.classList.remove('active'); el.style.transform = ''; }
            }
          });
        }
      }
    }, { passive: true });

    body.addEventListener('touchend', (e) => {
      if (!tracking) return;
      tracking = false;
      const t = e.changedTouches[0];
      const dx = t.clientX - sx;
      const dy = t.clientY - sy;
      const w = body.clientWidth || 1;
      const wasX = axis === 'x';
      axis = null;
      if (!wasX || Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy) * 1.1) {
        // snap back
        const curPage = document.getElementById(pages[curIdx]);
        if (curPage) {
          curPage.style.transition = 'transform 0.22s ease-out';
          curPage.style.transform = 'translateX(0)';
        }
        pages.forEach((id, i) => {
          if (i !== curIdx) {
            const el = document.getElementById(id);
            if (el) {
              el.style.transition = 'transform 0.22s ease-out';
              el.style.transform = '';
              setTimeout(() => { el.classList.remove('active'); el.style.transition = ''; }, 230);
            }
          }
        });
        return;
      }
      const next = dx < 0 ? curIdx + 1 : curIdx - 1;
      if (next < 0 || next >= pages.length) {
        goTo(curIdx);
        return;
      }
      // finish transition
      const curPage = document.getElementById(pages[curIdx]);
      const nextPage = document.getElementById(pages[next]);
      if (curPage) {
        curPage.style.transition = 'transform 0.22s ease-out';
        curPage.style.transform = 'translateX(' + (dx < 0 ? -w : w) + 'px)';
      }
      if (nextPage) {
        nextPage.classList.add('active');
        nextPage.style.transition = 'transform 0.22s ease-out';
        nextPage.style.transform = 'translateX(0)';
      }
      setTimeout(() => goTo(next), 230);
    }, { passive: true });
  })();



