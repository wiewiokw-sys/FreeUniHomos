  function loadComments() {
    if (!activeCommentsPostId) return;
    api('/posts/comments/' + encodeURIComponent(activeCommentsPostId))
      .then(list => {
        const box = document.getElementById('commentsList');
        if (!list.length) {
          box.innerHTML = `<div style="color:var(--text-muted);font-size:13px;text-align:center;padding:20px;">Нет комментариев</div>`;
          return;
        }
        box.innerHTML = list.map(c => {
          const canDel = c.from_handle === currentUser.handle || activeCommentsIsOwner;
          return `
          <div class="comment-row" id="cmt-${c.comment_id}">
