<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>FreeUniHomos</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

  :root {
    --bg: #10131a;
    --bg-2: #171c26;
    --panel: #1b202b;
    --panel-2: #212736;
    --panel-border: #2a3140;
    --accent: #f2a65a;
    --accent-dim: #d88f45;
    --tag: #5b8def;
    --text: #f5f3ef;
    --text-muted: #868c98;
    --err: #e5665c;
    --ok: #6fbf73;
    --bubble-color: #f2a65a;
    --bubble-text: #1a1200;
  }
  /* theme swatches in settings */
  .theme-swatch-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .theme-swatch {
    width: 36px; height: 36px; border-radius: 10px; border: 2px solid transparent;
    cursor: pointer; position: relative;
  }
  .theme-swatch.active { border-color: #fff; box-shadow: 0 0 0 2px var(--accent); }
  .lang-btns { display: flex; gap: 8px; margin-top: 8px; }
  .lang-btn {
    flex: 1; padding: 10px; border-radius: 12px; border: 1.5px solid var(--panel-border);
    background: var(--bg-2); color: var(--text); font-weight: 600; cursor: pointer;
    font-family: Inter, sans-serif; font-size: 13.5px;
  }
  .lang-btn.active { background: var(--accent); color: var(--bubble-text); border-color: var(--accent); }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    margin: 0; height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    overflow: hidden;
  }
  #root { position: relative; width: 100%; height: 100%; }
  .screen {
    position: absolute; inset: 0;
    display: none;
    flex-direction: column;
  }
  .screen.active { display: flex; }

  /* ============ AUTH SCREEN ============ */
  #screenAuth {
    align-items: center; justify-content: center;
    padding: 24px;
    background:
      radial-gradient(circle at 20% 15%, rgba(242,166,90,0.08), transparent 45%),
      radial-gradient(circle at 85% 85%, rgba(91,141,239,0.08), transparent 45%),
      var(--bg);
  }
  .card {
    width: 100%; max-width: 400px;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 28px;
    padding: 30px 30px 28px;
    box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
  }
  .logo-row { display: flex; align-items: center; gap: 10px; margin-bottom: 22px; }
  .logo-dot { width: 30px; height: 30px; border-radius: 10px; background: linear-gradient(135deg, var(--accent), var(--accent-dim)); flex-shrink: 0; }
  .logo-text { font-family: 'Fraunces', serif; font-weight: 700; font-size: 19px; }

  .tabs { display: flex; background: var(--bg-2); border: 1px solid var(--panel-border); border-radius: 16px; padding: 4px; margin-bottom: 22px; }
  .tab-btn { flex: 1; border: none; background: transparent; color: var(--text-muted); font-size: 14px; font-weight: 500; padding: 10px; border-radius: 12px; cursor: pointer; font-family: 'Inter', sans-serif; }
  .tab-btn.active { background: var(--accent); color: #1a1200; }

  h1 { font-family: 'Fraunces', serif; font-weight: 600; font-size: 22px; margin: 0 0 6px; }
  .subtitle { color: var(--text-muted); font-size: 13.5px; margin: 0 0 22px; line-height: 1.4; }
  .field { margin-bottom: 16px; }
  .field label { display: block; font-size: 12.5px; font-weight: 500; color: var(--text-muted); margin-bottom: 7px; }
  .input-wrap { position: relative; }
  input {
    width: 100%; background: var(--bg-2); border: 1.5px solid var(--panel-border);
    border-radius: 16px; padding: 13px 16px; font-size: 15px; color: var(--text);
    outline: none; font-family: 'Inter', sans-serif;
  }
  input.mono { font-family: 'JetBrains Mono', monospace; padding-left: 26px; }
  .at-sign { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--tag); font-family: 'JetBrains Mono', monospace; font-size: 15px; pointer-events: none; }
  input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(242,166,90,0.15); }
  .hint { font-size: 12px; margin-top: 6px; min-height: 15px; color: var(--text-muted); }
  .hint.error { color: var(--err); }

  button.primary {
    width: 100%; padding: 14px; border-radius: 16px; border: none;
    background: var(--accent); color: #1a1200; font-size: 15px; font-weight: 600;
    cursor: pointer; margin-top: 6px; font-family: 'Inter', sans-serif;
  }
  button.primary:disabled { background: var(--panel-border); color: var(--text-muted); }
  .form-msg { font-size: 13px; margin-top: 12px; min-height: 16px; text-align: center; }
  .form-msg.error { color: var(--err); }

  .auth-panel { display: none; }
  .auth-panel.active { display: block; }

  /* ============ LOADING / RESULT SCREEN ============ */
  #screenLoading { align-items: center; justify-content: center; background: var(--bg); text-align: center; padding: 24px; }
  .spinner {
    width: 60px; height: 60px; border-radius: 50%;
    border: 4px solid var(--panel-border); border-top-color: var(--accent);
    animation: spin 0.8s linear infinite; margin: 0 auto 24px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .result-icon {
    width: 64px; height: 64px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 30px; margin: 0 auto 20px;
    animation: pop 0.35s ease;
  }
  @keyframes pop { 0% { transform: scale(0.4); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
  .result-icon.ok { background: rgba(111,191,115,0.15); color: var(--ok); }
  .result-icon.fail { background: rgba(229,102,92,0.15); color: var(--err); }
  #loadingText { color: var(--text-muted); font-size: 14px; }
  #resultReason { color: var(--text-muted); font-size: 13.5px; max-width: 300px; margin: 0 auto 20px; line-height: 1.4; }
  #resultRetryBtn { max-width: 220px; }

  /* ============ MAIN APP ============ */
  #screenApp { background: var(--bg); }
  .app-body { flex: 1; overflow: hidden; position: relative; }
  .tab-page {
    position: absolute; inset: 0; display: none; flex-direction: column; overflow-y: auto;
    will-change: transform; background: var(--bg);
  }
  .tab-page.active { display: flex; }


  .topbar {
    padding: 16px 18px 12px; display: flex; align-items: center; gap: 10px;
    border-bottom: 1px solid var(--panel-border); flex-shrink: 0;
  }
  .topbar .logo-text { font-size: 17px; }

  /* bottom nav */
  .bottom-nav {
    display: flex; border-top: 1px solid var(--panel-border);
    background: var(--panel); flex-shrink: 0;
  }
  .nav-btn {
    flex: 1; background: none; border: none; color: var(--text-muted);
    padding: 10px 4px 12px; display: flex; flex-direction: column; align-items: center; gap: 4px;
    font-family: 'Inter', sans-serif; font-size: 10.5px; cursor: pointer;
  }
  .nav-btn .nav-icon { font-size: 20px; }

  /* SVG icons */
  .ico {
    width: 1em; height: 1em; display: block;
    flex-shrink: 0;
  }
  .nav-btn .nav-icon { display: flex; align-items: center; justify-content: center; line-height: 1; }
  .nav-btn .nav-icon .ico { width: 22px; height: 22px; }
  .search-icon { display: flex; align-items: center; justify-content: center; }
  .search-icon .ico { width: 16px; height: 16px; }
  .circle-btn .ico { width: 28px; height: 28px; }
  .empty-emoji { display: flex; align-items: center; justify-content: center; color: var(--text-muted); }
  .empty-emoji .ico { width: 48px; height: 48px; }
  .edit-pencil { display: flex; align-items: center; justify-content: center; }
  .edit-pencil .ico { width: 14px; height: 14px; }
  .profile-action-icon .ico { width: 22px; height: 22px; }
  .voice-ctrl-icon .ico { width: 22px; height: 22px; }
  .composer-btn { display: flex; align-items: center; justify-content: center; }
  .composer-btn .ico { width: 20px; height: 20px; }
  .back-btn { display: flex; align-items: center; justify-content: center; }
  .back-btn .ico { width: 22px; height: 22px; }
  .chat-avatar .ico { width: 22px; height: 22px; }
  .post-comment-btn .ico, .post-delete-btn .ico { width: 14px; height: 14px; display: inline-block; vertical-align: -2px; }
  .volume-row { display: flex; align-items: center; gap: 8px; }
  .volume-row .ico { width: 16px; height: 16px; color: var(--text-muted); }
  .emoji-picker-btn { display: flex; align-items: center; justify-content: center; }
  .emoji-picker-btn .ico { width: 18px; height: 18px; }
  .rec-cancel, .rec-send { display: flex; align-items: center; justify-content: center; }
  .rec-cancel .ico, .rec-send .ico { width: 16px; height: 16px; }
  .btn-cancel .ico { width: 14px; height: 14px; display: inline-block; vertical-align: -2px; margin-right: 4px; }
  .post-create-actions .btn-cancel { display: inline-flex; align-items: center; }

  .nav-btn.active { color: var(--accent); }

  /* Chats list */
  .chat-list {
    padding: 6px 0;
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .chat-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,0.03);
    width: 100%;
    box-sizing: border-box;
    flex-shrink: 0;
  }
  .section-header {
    width: 100%;
    flex-shrink: 0;
  }
  .chat-avatar {
    width: 46px; height: 46px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; font-weight: 600;
    background: linear-gradient(135deg, var(--tag), #3a63c9);
    color: #ffffff !important;
  }
  .chat-avatar .ico { color: #ffffff !important; stroke: #ffffff; }
  .chat-avatar.saved {
    background: linear-gradient(135deg, #f2a65a, #d88f45) !important;
    color: #ffffff !important;
  }
  .chat-avatar.saved .ico { color: #ffffff !important; stroke: #ffffff; fill: #ffffff; }
  .chat-header-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    overflow: visible; position: relative; flex-shrink: 0;
    color: #ffffff !important;
  }
  .chat-header-avatar .chat-avatar-wrap { width: 100%; height: 100%; border-radius: 50%; overflow: visible; }
  .chat-header-avatar img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }

  .chat-header-avatar .ico { color: #ffffff !important; stroke: #ffffff; }
  .chat-avatar.voice { background: linear-gradient(135deg, #9b6fd4, #6f3fbf); }
  .chat-info { flex: 1; min-width: 0; }
  .chat-name { font-size: 15px; font-weight: 600; }
  .chat-sub { font-size: 13px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chat-meta { text-align: right; flex-shrink: 0; }
  .chat-time { font-size: 11.5px; color: var(--text-muted); }

  .empty-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--text-muted); font-size: 14px; padding: 30px; text-align: center; gap: 8px; }
  .empty-emoji { font-size: 40px; margin-bottom: 6px; }

  /* Home tab */
  .home-search { padding: 14px 18px 6px; flex-shrink: 0; }
  .search-input-wrap { position: relative; }
  .search-input-wrap input { padding-left: 40px; }
  .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 15px; }
  .search-results { padding: 4px 18px 0; }
  .search-result-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
  .home-actions { padding: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .action-card {
    background: var(--panel); border: 1px solid var(--panel-border); border-radius: 18px;
    padding: 16px; cursor: pointer; transition: all 0.15s ease; overflow: hidden;
  }
  .action-card .a-icon { font-size: 22px; margin-bottom: 8px; }
  .action-card .a-label { font-size: 13.5px; font-weight: 600; }
  .action-card.full { grid-column: 1 / -1; }
  .action-form { display: none; margin-top: 14px; }
  .action-card.expanded .action-form { display: block; }
  .action-card.expanded .a-collapsed-hint { display: none; }
  .action-form .field { margin-bottom: 10px; }
  .action-form label { display: block; font-size: 11.5px; color: var(--text-muted); margin-bottom: 5px; }
  .action-btns-row { display: flex; gap: 8px; margin-top: 12px; }
  .action-btns-row button { flex: 1; padding: 10px; border-radius: 12px; border: none; font-size: 13.5px; font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif; }
  .btn-cancel { background: var(--bg-2); color: var(--text-muted); }
  .btn-create { background: var(--accent); color: #1a1200; }
  .btn-create:disabled { background: var(--panel-border); color: var(--text-muted); }

  /* Voice tab */
  .voice-active-screen { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 30px; gap: 20px; }
  .voice-room-name { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 600; }
  .voice-avatar-ring {
    width: 100px; height: 100px; border-radius: 50%;
    background: linear-gradient(135deg, #9b6fd4, #6f3fbf);
    display: flex; align-items: center; justify-content: center; font-size: 38px;
    box-shadow: 0 0 0 6px rgba(155,111,212,0.15);
  }
  .voice-status { color: var(--text-muted); font-size: 13px; }
  .voice-controls { display: flex; gap: 16px; margin-top: 10px; }
  .voice-btn {
    width: 58px; height: 58px; border-radius: 50%; border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 22px;
    background: var(--panel-2); color: var(--text);
  }
  .voice-btn.talk.active { background: var(--ok); color: #06210a; }
  .voice-btn.mute.active { background: var(--err); color: #2a0705; }
  .voice-btn.leave { background: var(--err); color: #fff; }

  /* Profile tab — new layout matching the sketch */
  .profile-body { padding: 18px 18px 30px; overflow-y: auto; }
  .profile-title { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 600; margin: 0 0 18px; text-align: center; }
  .profile-header {
    display: flex; align-items: flex-start; gap: 14px; margin-bottom: 18px;
    padding-bottom: 16px; border-bottom: 1px solid var(--panel-border);
  }
  .profile-avatar {
    width: 72px; height: 72px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--accent), var(--accent-dim));
    display: flex; align-items: center; justify-content: center; font-size: 26px; font-weight: 700; color: #1a1200;
    overflow: hidden; position: relative;
  }
  .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .profile-header-info { flex: 1; min-width: 0; }
  .profile-name-edit-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
  .profile-name-display { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 600; }
  .profile-handle-edit-row { display: flex; align-items: center; gap: 8px; }
  .profile-handle-display { font-family: 'JetBrains Mono', monospace; font-size: 14px; color: var(--tag); }
  .edit-pencil {
    width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--panel-border);
    background: var(--panel-2); color: var(--text-muted); font-size: 14px;
    display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0;
  }
  .edit-pencil:active { background: var(--accent); color: #1a1200; }

  .profile-section-label {
    display: flex; align-items: center; gap: 6px;
    font-size: 14px; font-weight: 600; margin: 16px 0 10px; color: var(--text);
  }
  .profile-section-label .arrow { color: var(--text-muted); font-size: 12px; }

  .achievements-box {
    background: var(--panel); border: 1.5px solid var(--panel-border); border-radius: 16px;
    padding: 28px 16px; text-align: center; color: var(--text-muted); font-size: 15px;
  }

  .posts-area {
    background: var(--panel); border: 1.5px solid var(--panel-border); border-radius: 16px;
    overflow: hidden;
  }
  .posts-photo-placeholder {
    height: 120px; display: flex; align-items: center; justify-content: center;
    background: var(--bg-2); color: var(--text-muted); font-size: 28px; font-weight: 600;
    border-bottom: 1px solid var(--panel-border);
  }
  .posts-text-bar {
    padding: 12px 14px; font-size: 14px; color: var(--text-muted);
  }

  .profile-bottom-actions {
    display: flex; justify-content: space-around; gap: 10px;
    margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--panel-border);
  }
  .profile-action-btn {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    background: none; border: none; color: var(--text-muted); cursor: pointer;
    font-family: 'Inter', sans-serif; font-size: 10.5px; padding: 0;
  }
  .profile-action-icon {
    width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid var(--panel-border);
    background: var(--panel-2); display: flex; align-items: center; justify-content: center;
    font-size: 20px;
  }
  .profile-action-btn:active .profile-action-icon { border-color: var(--accent); }

  /* hidden edit panels (opened by pencils / bottom icons) */
  .profile-edit-panel {
    display: none; margin-top: 14px; padding: 16px;
    background: var(--panel); border: 1px solid var(--panel-border); border-radius: 16px;
  }
  .profile-edit-panel.open { display: block; }
  .profile-field { margin-bottom: 14px; }
  .profile-field label { display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; }
  .id-display-row { display: flex; gap: 8px; align-items: center; }
  .id-display-row input { font-family: 'JetBrains Mono', monospace; color: var(--accent); }
  .copy-btn { background: var(--panel-2); border: 1px solid var(--panel-border); color: var(--text); border-radius: 12px; padding: 12px 14px; cursor: pointer; font-size: 13px; white-space: nowrap; }
  .save-hint { font-size: 12px; color: var(--ok); text-align: center; margin-top: 4px; min-height: 15px; }
  .emoji-picker-btn { font-size: 18px; background: var(--panel-2); border: 1px solid var(--panel-border); border-radius: 10px; width: 34px; height: 34px; cursor: pointer; }
  .emoji-popup { display: none; flex-wrap: wrap; gap: 8px; background: var(--panel-2); border: 1px solid var(--panel-border); border-radius: 14px; padding: 10px; margin-top: 10px; max-width: 260px; }
  .emoji-popup.show { display: flex; }
  .emoji-popup span { font-size: 20px; cursor: pointer; padding: 4px; }
  .unread-badge {
    background: var(--accent); color: #1a1200; font-size: 11.5px; font-weight: 700;
    min-width: 20px; height: 20px; border-radius: 10px; display: flex; align-items: center; justify-content: center; padding: 0 6px;
  }
  .type-tag { font-size: 10.5px; color: var(--tag); margin-left: 4px; }

  /* ============ CHAT DETAIL SCREEN (Saved messages etc) ============ */
  #screenChat { background: var(--bg); }
  .chat-header { display: flex; align-items: center; gap: 10px; padding: 12px 12px; border-bottom: 1px solid var(--panel-border); flex-shrink: 0; }
  .chat-header-info { flex: 1; min-width: 0; }
  .back-btn { background: none; border: none; color: var(--text); font-size: 20px; cursor: pointer; padding: 4px 8px; }
  .chat-header-name { font-weight: 600; font-size: 15.5px; }
  .messages-area { flex: 1; overflow-y: auto; padding: 14px 14px 6px; display: flex; flex-direction: column; gap: 8px; }

  .msg-bubble { max-width: 78%; align-self: flex-end; background: var(--bubble-color); color: var(--bubble-text); border-radius: 16px 16px 4px 16px; padding: 9px 12px; font-size: 14.5px; position: relative; }
  .msg-sender-row { display: flex; align-items: center; gap: 6px; margin-bottom: 3px; padding: 0 4px; }
  .msg-row { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
  .msg-row.incoming { align-items: flex-start; }
  .msg-row > .msg-sender-row { order: 0; }
  .msg-row > .msg-bubble-wrap { order: 1; display: flex; align-items: flex-end; gap: 6px; max-width: 100%; }
  .msg-row.incoming > .msg-bubble-wrap { flex-direction: row; }
  .msg-sender-avatar { width: 20px; height: 20px; border-radius: 50%; background: var(--tag); display: flex; align-items: center; justify-content: center; font-size: 10px; color: #fff; overflow: hidden; flex-shrink: 0; }
  .msg-sender-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .msg-sender-name { font-size: 12px; font-weight: 700; color: #ffffff; }
  .msg-reply-quote { border-left: 2px solid rgba(0,0,0,0.25); padding: 3px 8px; margin-bottom: 5px; font-size: 12.5px; opacity: 0.75; }
  .msg-forwarded-tag { font-size: 11px; opacity: 0.7; margin-bottom: 3px; font-style: italic; }
  .reply-bar { display: flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--panel); border-top: 1px solid var(--panel-border); }
  .msg-bubble.photo { padding: 6px; }
  .msg-bubble.photo img { max-width: 100%; border-radius: 12px; display: block; }
  .msg-bubble.voice { display: flex; align-items: center; gap: 8px; min-width: 180px; }
  .voice-play-btn { width: 30px; height: 30px; border-radius: 50%; background: rgba(0,0,0,0.15); border: none; color: inherit; cursor: pointer; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .voice-play-btn .ico { width: 14px; height: 14px; }
  .waveform { display: flex; align-items: center; gap: 2px; flex: 1; height: 22px; }
  .waveform span { width: 3px; background: color-mix(in srgb, var(--bubble-text) 50%, transparent); border-radius: 2px; }
  .msg-meta { display: flex; justify-content: flex-end; align-items: center; gap: 4px; margin-top: 3px; font-size: 10.5px; color: color-mix(in srgb, var(--bubble-text) 55%, transparent); }
  .msg-time { }
  .ticks { font-size: 11px; }
  .ticks.pending { color: rgba(26,18,0,0.4); }

  .composer { display: flex; align-items: flex-end; gap: 8px; padding: 10px 12px; border-top: 1px solid var(--panel-border); flex-shrink: 0; background: var(--panel); }
  .composer textarea {
    flex: 1; resize: none; background: var(--bg-2); border: 1.5px solid var(--panel-border);
    border-radius: 18px; padding: 10px 14px; color: var(--text); font-size: 14.5px; font-family: 'Inter', sans-serif;
    max-height: 100px; outline: none;
  }
  .composer-btn { background: var(--panel-2); border: none; color: var(--text); width: 42px; height: 42px; border-radius: 50%; cursor: pointer; font-size: 18px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .composer-btn.send { background: var(--accent); color: #1a1200; }

  .recording-bar { display: none; align-items: center; gap: 10px; padding: 10px 16px; background: var(--panel); border-top: 1px solid var(--panel-border); }
  .recording-bar.active { display: flex; }
  .rec-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--err); animation: pulse 1s infinite; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .rec-timer { font-family: 'JetBrains Mono', monospace; font-size: 14px; flex: 1; }
  .rec-cancel, .rec-send { border: none; border-radius: 50%; width: 36px; height: 36px; cursor: pointer; font-size: 15px; }
  .rec-cancel { background: var(--panel-2); color: var(--err); }
  .rec-send { background: var(--accent); color: #1a1200; }

  /* Section headers in chat list */
  .section-header {
    padding: 12px 18px 6px; font-size: 12px; font-weight: 600;
    color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em;
  }
  .online-dot {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ok);
    border: 2px solid var(--bg);
    z-index: 3;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.2);
  }
  .chat-avatar-wrap { position: relative; flex-shrink: 0; overflow: visible; }
  .chat-avatar { overflow: hidden; }

  /* Home circle actions */
  .home-circles {
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 20px; padding: 28px 18px 20px;
  }
  .circle-action {
    width: 78px; display: flex; flex-direction: column; align-items: center; gap: 8px;
    background: none; border: none; cursor: pointer; color: var(--text);
    font-family: 'Inter', sans-serif; padding: 0;
  }
  .circle-btn {
    width: 64px; height: 64px; border-radius: 50%;
    background: #f5f3ef; color: #1a1200;
    display: flex; align-items: center; justify-content: center;
    font-size: 26px; box-shadow: 0 4px 14px rgba(0,0,0,0.25);
    transition: transform 0.12s ease;
  }
  .circle-action:active .circle-btn { transform: scale(0.92); }
  .circle-label { font-size: 11.5px; font-weight: 600; color: var(--text-muted); text-align: center; }

  .create-form-panel {
    display: none; margin: 0 18px 16px; padding: 16px;
    background: var(--panel); border: 1px solid var(--panel-border); border-radius: 18px;
  }
  .create-form-panel.open { display: block; }

  /* Voice list */
  .voice-list { padding: 8px 0; }
  .voice-list-title {
    padding: 14px 18px 8px; font-family: 'Fraunces', serif;
    font-size: 17px; font-weight: 600;
  }

  /* Voice room UI */
  .voice-room {
    flex: 1; display: flex; flex-direction: column; overflow: hidden;
  }
  .voice-room-header {
    padding: 14px 18px 8px; text-align: center; flex-shrink: 0;
  }
  .voice-room-header .vr-name { font-family: 'Fraunces', serif; font-size: 18px; font-weight: 600; }
  .voice-room-header .vr-handle { font-size: 12.5px; color: var(--tag); font-family: 'JetBrains Mono', monospace; }
  .voice-members {
    flex: 1; overflow-y: auto; padding: 8px 14px;
  }
  .voice-member-row {
    display: flex; align-items: center; gap: 10px; padding: 10px 8px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .voice-member-row .vm-avatar {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #9b6fd4, #6f3fbf);
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 600; color: #fff; overflow: hidden;
  }
  .voice-member-row.talking .vm-avatar {
    box-shadow: 0 0 0 3px rgba(111,191,115,0.5);
  }
  .vm-info { flex: 1; min-width: 0; }
  .vm-name { font-size: 14px; font-weight: 600; }
  .vm-handle { font-size: 11.5px; color: var(--text-muted); }
  .vm-status {
    font-size: 12px; font-weight: 600;
    color: var(--text-muted);
  }
  .vm-status.speaking { color: var(--ok); }
  .vm-eph {
    font-size: 20px; margin-left: 6px;
  }
  .voice-eph-feed {
    max-height: 100px; overflow-y: auto; padding: 6px 14px;
    border-top: 1px solid var(--panel-border);
  }
  .voice-eph-item {
    font-size: 13px; padding: 4px 0; color: var(--text-muted);
  }
  .voice-eph-item strong { color: var(--text); }
  .voice-room-footer {
    flex-shrink: 0; padding: 12px 16px 16px;
    border-top: 1px solid var(--panel-border); background: var(--panel);
  }
  .voice-count { text-align: center; font-size: 12.5px; color: var(--text-muted); margin-bottom: 10px; }
  .voice-controls-row {
    display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
  }
  .voice-ctrl {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    background: none; border: none; color: var(--text-muted); cursor: pointer;
    font-family: 'Inter', sans-serif; font-size: 10.5px; padding: 0;
  }
  .voice-ctrl-icon {
    width: 52px; height: 52px; border-radius: 50%;
    background: var(--panel-2); border: 1.5px solid var(--panel-border);
    display: flex; align-items: center; justify-content: center; font-size: 20px;
  }
  .voice-ctrl.active .voice-ctrl-icon { background: var(--ok); color: #06210a; border-color: var(--ok); }
  .voice-ctrl.danger .voice-ctrl-icon { background: var(--err); color: #fff; border-color: var(--err); }
  .voice-emoji-bar {
    display: none; flex-wrap: wrap; gap: 8px; justify-content: center;
    padding: 10px 0 4px;
  }
  .voice-emoji-bar.show { display: flex; }
  .voice-emoji-bar span { font-size: 24px; cursor: pointer; padding: 4px; }
  .voice-text-row {
    display: none; gap: 8px; margin-top: 8px; align-items: center;
  }
  .voice-text-row.show { display: flex; }
  .voice-text-row input {
    flex: 1; background: var(--bg-2); border: 1.5px solid var(--panel-border);
    border-radius: 14px; padding: 10px 12px; color: var(--text); font-size: 14px;
  }
  .voice-text-row button {
    background: var(--accent); color: #1a1200; border: none; border-radius: 12px;
    padding: 10px 14px; font-weight: 600; cursor: pointer; font-size: 13px;
  }

  /* Volume slider in settings */
  .volume-row {
    display: flex; align-items: center; gap: 12px; margin-top: 8px;
  }
  .volume-row input[type=range] {
    flex: 1; accent-color: var(--accent); height: 6px;
  }
  .volume-val { font-size: 13px; color: var(--text-muted); min-width: 36px; text-align: right; }

  /* Privacy toggles */
  .privacy-toggle {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .privacy-toggle:last-child { border-bottom: none; }
  .privacy-toggle span { font-size: 13.5px; }

  /* ============ APP MODALS (settings + other profile) ============ */
  .app-modal-backdrop {
    position: fixed; inset: 0; z-index: 9000;
    background: rgba(0,0,0,0.4);
    display: none; align-items: center; justify-content: center;
    padding: 18px;
  }
  .app-modal-backdrop.show { display: flex; }
  .app-modal {
    width: min(420px, 100%);
    max-height: min(78vh, 640px);
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 22px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.55);
    display: flex; flex-direction: column;
    overflow: hidden;
  }
  .app-modal.compact {
    max-height: min(46vh, 360px);
    width: min(320px, 92vw);
  }
  .app-modal-header {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 16px; border-bottom: 1px solid var(--panel-border); flex-shrink: 0;
  }
  .app-modal-header .title { flex: 1; font-weight: 600; font-size: 15.5px; }
  .app-modal-close {
    background: var(--bg-2); border: 1px solid var(--panel-border);
    color: var(--text-muted); width: 34px; height: 34px; border-radius: 50%;
    cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center;
    position: relative; z-index: 5; flex-shrink: 0;
  }
  .app-modal-body {
    flex: 1; overflow-y: auto; padding: 14px 16px 18px;
    -webkit-overflow-scrolling: touch;
  }
  .color-swatches { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .color-swatch {
    width: 34px; height: 34px; border-radius: 50%; border: 2px solid transparent;
    cursor: pointer; position: relative;
  }
  .color-swatch.active { border-color: #fff; box-shadow: 0 0 0 2px var(--accent); }
  .color-swatch[data-c="orange"] { background: #f2a65a; }
  .color-swatch[data-c="green"] { background: #6fbf73; }
  .color-swatch[data-c="blue"] { background: #5b8def; }
  .color-swatch[data-c="red"] { background: #e5665c; }
  .color-swatch[data-c="black"] { background: #1a1a1a; }
  .color-swatch[data-c="white"] { background: #f5f3ef; border-color: #555; }
  .color-swatch[data-c="pink"] { background: #e891c0; }
  .color-swatch[data-c="cyan"] { background: #4ecdc4; }
  .color-swatch[data-c="yellow"] { background: #e8c547; }
  .toggle-switch {
    width: 44px; height: 24px; border-radius: 12px; background: var(--panel-border);
    position: relative; cursor: pointer; flex-shrink: 0; transition: background 0.2s;
  }
  .toggle-switch.on { background: var(--ok); }
  .toggle-switch::after {
    content: ''; position: absolute; top: 3px; left: 3px;
    width: 18px; height: 18px; border-radius: 50%; background: #fff;
    transition: transform 0.2s;
  }
  .toggle-switch.on::after { transform: translateX(20px); }

  /* Posts */
  .post-card {
    background: var(--panel); border: 1.5px solid var(--panel-border); border-radius: 16px;
    overflow: hidden; margin-bottom: 12px;
  }
  .post-photo { width: 100%; max-height: 280px; object-fit: cover; display: block; background: var(--bg-2); }
  .post-text { padding: 12px 14px; font-size: 14px; line-height: 1.45; white-space: pre-wrap; word-break: break-word; }
  .post-actions {
    display: flex; align-items: center; gap: 6px; padding: 8px 12px 10px;
    border-top: 1px solid rgba(255,255,255,0.04); flex-wrap: wrap;
  }
  .post-react-btn {
    background: var(--panel-2); border: 1px solid var(--panel-border); border-radius: 20px;
    padding: 5px 10px; font-size: 14px; cursor: pointer; color: var(--text);
    font-family: 'Inter', sans-serif; display: flex; align-items: center; gap: 4px;
  }
  .post-react-btn.active { border-color: var(--accent); background: rgba(242,166,90,0.12); }
  .post-react-btn .cnt { font-size: 12px; color: var(--text-muted); }
  .post-comment-btn {
    background: none; border: none; color: var(--text-muted); font-size: 13px;
    cursor: pointer; margin-left: auto; font-family: 'Inter', sans-serif;
    display: flex; align-items: center; gap: 4px;
  }
  .post-delete-btn {
    background: none; border: none; color: var(--err); font-size: 12px; cursor: pointer;
    font-family: 'Inter', sans-serif; padding: 4px 6px;
  }
  .post-create-box {
    background: var(--panel); border: 1.5px dashed var(--panel-border); border-radius: 16px;
    padding: 14px; margin-bottom: 14px;
  }
  .post-create-box textarea {
    width: 100%; background: var(--bg-2); border: 1.5px solid var(--panel-border);
    border-radius: 12px; padding: 10px 12px; color: var(--text); font-size: 14px;
    font-family: 'Inter', sans-serif; resize: none; min-height: 60px; outline: none;
  }
  .post-create-actions { display: flex; gap: 8px; margin-top: 10px; align-items: center; }
  .post-create-actions button {
    padding: 8px 14px; border-radius: 12px; border: none; font-size: 13px; font-weight: 600;
    cursor: pointer; font-family: 'Inter', sans-serif;
  }
  .post-photo-preview {
    max-width: 100%; max-height: 160px; border-radius: 12px; margin-top: 8px; display: none;
  }

  /* Other user profile screen */
  #screenUserProfile { background: var(--bg); }
  .up-header {
    display: flex; align-items: center; gap: 12px; padding: 12px 16px;
    border-bottom: 1px solid var(--panel-border); flex-shrink: 0;
  }
  .up-body { flex: 1; overflow-y: auto; padding: 18px; }

  /* Comments overlay */
  #commentsOverlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55);
    z-index: 60; align-items: flex-end; justify-content: center;
  }
  #commentsOverlay.show { display: flex; }
  .comments-sheet {
    width: 100%; max-width: 480px; max-height: 70vh; background: var(--panel);
    border-radius: 20px 20px 0 0; display: flex; flex-direction: column;
    border: 1px solid var(--panel-border); border-bottom: none;
  }
  .comments-sheet-header {
    padding: 14px 16px; border-bottom: 1px solid var(--panel-border);
    display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;
  }
  .comments-list { flex: 1; overflow-y: auto; padding: 10px 16px; }
  .comment-row {
    padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .comment-row-top { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
  .comment-avatar {
    width: 28px; height: 28px; border-radius: 50%; background: var(--tag);
    display: flex; align-items: center; justify-content: center; font-size: 12px; color: #fff;
    overflow: hidden; flex-shrink: 0;
  }
  .comment-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .comment-name { font-size: 13px; font-weight: 600; }
  .comment-text { font-size: 13.5px; color: var(--text); line-height: 1.4; padding-left: 36px; word-break: break-word; }
  .comment-del { background: none; border: none; color: var(--err); font-size: 11px; cursor: pointer; margin-left: auto; }
  .comments-composer {
    display: flex; gap: 8px; padding: 10px 14px; border-top: 1px solid var(--panel-border);
    flex-shrink: 0; background: var(--panel);
  }
  .comments-composer input {
    flex: 1; background: var(--bg-2); border: 1.5px solid var(--panel-border);
    border-radius: 16px; padding: 10px 14px; color: var(--text); font-size: 14px;
  }
  .comments-composer button {
    background: var(--accent); color: #1a1200; border: none; border-radius: 14px;
    padding: 10px 16px; font-weight: 600; cursor: pointer; font-size: 13px;
  }

  /* Gemini-style star icon */
  .icon-gemini-stars {
    width: 22px; height: 22px; display: inline-block; position: relative;
  }
  .icon-gemini-stars svg { position: absolute; }
  .icon-gemini-stars .star-big { width: 16px; height: 16px; top: 0; left: 0; }
  .icon-gemini-stars .star-small { width: 11px; height: 11px; bottom: 0; right: 0; }

  .clickable-avatar { cursor: pointer; }


  /* Custom range slider */
  .volume-row input[type=range] {
    flex: 1; height: 6px; -webkit-appearance: none; appearance: none;
    background: transparent; outline: none;
  }
  .volume-row input[type=range]::-webkit-slider-runnable-track {
    height: 6px; border-radius: 3px;
    background: linear-gradient(to right, var(--accent) 0%, var(--accent) var(--vol-pct, 70%), var(--panel-border) var(--vol-pct, 70%), var(--panel-border) 100%);
  }
  .volume-row input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 18px; height: 18px; border-radius: 50%;
    background: var(--accent); margin-top: -6px; cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.35);
  }
  .volume-row input[type=range]::-moz-range-track {
    height: 6px; border-radius: 3px; background: var(--panel-border);
  }
  .volume-row input[type=range]::-moz-range-progress {
    height: 6px; border-radius: 3px; background: var(--accent);
  }
  .volume-row input[type=range]::-moz-range-thumb {
    width: 18px; height: 18px; border-radius: 50%; background: var(--accent);
    border: none; cursor: pointer;
  }
  .vol-save-btn {
    margin-top: 10px; width: 100%; padding: 10px; border-radius: 12px; border: none;
    background: var(--accent); color: #1a1200; font-weight: 600; font-size: 13.5px;
    cursor: pointer; font-family: 'Inter', sans-serif;
  }

  /* Chat header enriched */
  .chat-header { gap: 10px; }
  .chat-header-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
  .chat-header-name { font-weight: 600; font-size: 15.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chat-header-sub { font-size: 12px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chat-header-sub.online { color: var(--ok); }
  .chat-header-avatar {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, var(--tag), #3a63c9);
    display: flex; align-items: center; justify-content: center;
    font-size: 15px; font-weight: 600; color: #fff; overflow: hidden; position: relative;
  }
  .chat-header-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .chat-header-avatar .online-dot {
    position: absolute; top: 0; right: 0; width: 11px; height: 11px;
    border-radius: 50%; background: var(--ok); border: 2px solid var(--bg);
  }

  /* Pinned bar */
  .pinned-bar {
    display: none; flex-shrink: 0; align-items: center; gap: 10px;
    padding: 8px 14px; background: var(--panel); border-bottom: 1px solid var(--panel-border);
    cursor: pointer;
  }
  .pinned-bar.show { display: flex; }
  .pinned-bar .pin-ico { color: var(--accent); flex-shrink: 0; }
  .pinned-bar .pin-ico .ico { width: 16px; height: 16px; }
  .pinned-bar-text { flex: 1; min-width: 0; }
  .pinned-bar-label { font-size: 11px; color: var(--accent); font-weight: 600; }
  .pinned-bar-preview { font-size: 13px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pinned-bar-close { background: none; border: none; color: var(--text-muted); font-size: 16px; cursor: pointer; padding: 4px; }

  /* Message row with side actions — name above bubble */
  .msg-row {
    display: flex; flex-direction: column; align-items: flex-end; gap: 2px; max-width: 100%;
    align-self: flex-end;
  }
  .msg-row.incoming { align-self: flex-start; align-items: flex-start; }
  .msg-row .msg-bubble { max-width: 100%; }
  .msg-bubble-wrap { display: flex; align-items: flex-end; gap: 6px; max-width: 100%; }
  .msg-row.incoming .msg-bubble-wrap { flex-direction: row; }
  .msg-side-btn {
    width: 32px; height: 32px; border-radius: 50%; border: none;
    background: var(--panel-2); color: var(--text-muted); cursor: pointer;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    opacity: 0.7;
  }
  .msg-side-btn .ico { width: 15px; height: 15px; }
  .msg-side-btn:active { background: var(--accent); color: #1a1200; opacity: 1; }

  .msg-bubble.highlight-glow {
    box-shadow: 0 0 0 2px rgba(255,255,255,0.55), 0 0 18px rgba(255,255,255,0.33);
    transition: box-shadow 0.3s ease;
  }

  /* Centered action sheet */
  .modal-center-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55);
    z-index: 80; align-items: center; justify-content: center; padding: 20px;
  }
  .modal-center-overlay.show { display: flex; }
  .modal-center-card {
    width: 100%; max-width: 340px; background: var(--panel);
    border: 1px solid var(--panel-border); border-radius: 20px;
    padding: 8px 0 12px; box-shadow: 0 20px 50px rgba(0,0,0,0.45);
  }
  .modal-action-item {
    width: 100%; display: flex; align-items: center; gap: 12px;
    padding: 13px 20px; background: none; border: none; color: var(--text);
    font-size: 15px; cursor: pointer; font-family: 'Inter', sans-serif; text-align: left;
  }
  .modal-action-item:active { background: rgba(255,255,255,0.04); }
  .modal-action-item.danger { color: var(--err); }
  .modal-action-item .ico { width: 20px; height: 20px; flex-shrink: 0; }
  .modal-action-cancel {
    width: calc(100% - 32px); margin: 8px 16px 4px; padding: 12px; border-radius: 14px;
    border: none; background: var(--bg-2); color: var(--text-muted); font-size: 14.5px;
    font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif;
  }

  /* App prompt/confirm modal */
  .app-dialog-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55);
    z-index: 100; align-items: center; justify-content: center; padding: 20px;
  }
  .app-dialog-overlay.show { display: flex; }
  .app-dialog {
    width: 100%; max-width: 340px; background: var(--panel);
    border: 1px solid var(--panel-border); border-radius: 18px; padding: 20px;
  }
  .app-dialog-title { font-size: 16px; font-weight: 600; margin: 0 0 8px; }
  .app-dialog-body { font-size: 13.5px; color: var(--text-muted); margin: 0 0 14px; line-height: 1.4; }
  .app-dialog input, .app-dialog textarea {
    width: 100%; background: var(--bg-2); border: 1.5px solid var(--panel-border);
    border-radius: 12px; padding: 11px 14px; color: var(--text); font-size: 14.5px;
    font-family: 'Inter', sans-serif; outline: none; margin-bottom: 14px;
  }
  .app-dialog textarea { min-height: 80px; resize: vertical; }
  .app-dialog-actions { display: flex; gap: 10px; justify-content: flex-end; }
  .app-dialog-actions button {
    padding: 10px 16px; border-radius: 12px; border: none; font-size: 14px;
    font-weight: 600; cursor: pointer; font-family: 'Inter', sans-serif;
  }
  .app-dialog-cancel { background: var(--bg-2); color: var(--text-muted); }
  .app-dialog-ok { background: var(--accent); color: #1a1200; }
  .app-dialog-ok.danger { background: rgba(229,102,92,0.2); color: var(--err); }

  /* Swipeable tabs */
  .app-body { touch-action: pan-y; }


  /* Bounce dots loader */
  .bounce-loader {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 28px 16px;
  }
  .bounce-loader span {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--accent);
    animation: bounceDot 0.7s ease-in-out infinite;
  }
  .bounce-loader span:nth-child(1) { animation-delay: 0s; }
  .bounce-loader span:nth-child(2) { animation-delay: 0.12s; }
  .bounce-loader span:nth-child(3) { animation-delay: 0.24s; }
  .bounce-loader span:nth-child(4) { animation-delay: 0.36s; }
  @keyframes bounceDot {
    0%, 80%, 100% { transform: translateY(0); opacity: 0.45; }
    40% { transform: translateY(-12px); opacity: 1; }
  }
  .chat-loading-more {
    text-align: center; padding: 10px; color: var(--text-muted); font-size: 12px;
  }


  .reload-overlay {
    display: none; position: fixed; inset: 0; z-index: 200;
    background: var(--bg); flex-direction: column;
    align-items: center; justify-content: center; gap: 18px;
  }
  .reload-overlay.show { display: flex; }
  .reload-overlay-text { color: var(--text-muted); font-size: 14px; }

  #settingsModalBody .profile-edit-panel {
    display: block !important;
    border: none;
    padding: 0;
    background: transparent;
    margin: 0;
  }
  .msg-row.incoming .msg-sender-name { color: #ffffff; }

</style>
</head>
<body>

<div id="root">

  <!-- ======================= AUTH SCREEN ======================= -->
