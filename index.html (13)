              <div><div style="font-size:14px;font-weight:600;">${escapeHtml(en.name)}<span class="type-tag">Группа</span></div><div style="font-size:12px;color:var(--text-muted);">@${escapeHtml(en.handle)}</div></div>
            </div>`;
          });
        }
        if (voices.length) {
          html += `<div class="section-header">войс</div>`;
          voices.forEach(en => {
            html += `
            <div class="search-result-row" onclick="openEntityByHandle('${escapeHtml(en.handle)}', 'voice')" style="cursor:pointer;">
              <div class="chat-avatar voice" style="width:36px;height:36px;font-size:14px;"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v4"/><path d="M8 22h8"/></svg></div>
