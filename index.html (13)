            <div><div style="font-size:14px;font-weight:600;">${escapeHtml(p.name)}${p.tag_emoji ? ' ' + p.tag_emoji : ''}<span class="type-tag">люди</span></div><div style="font-size:12px;color:var(--text-muted);">@${escapeHtml(p.handle)}</div></div>
