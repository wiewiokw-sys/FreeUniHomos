      <div class="app-modal-body" id="settingsModalBody">
        <!-- filled by JS from panelEditProfile content -->
      </div>
    </div>
  </div>

  <!-- Other user profile modal -->
  <div class="app-modal-backdrop" id="userProfileModal">
    <div class="app-modal" id="userProfileModalBox">
      <div class="app-modal-header">
        <div class="title" id="userProfileModalTitle">Профиль</div>
        <button class="app-modal-close" id="userProfileModalClose" type="button">✕</button>
      </div>
      <div class="app-modal-body" id="userProfileModalBody">
        <div style="text-align:center;padding:30px;color:var(--text-muted);">Загрузка...</div>
      </div>
    </div>
  </div>

  <div id="reloadOverlay" class="reload-overlay">
    <div class="bounce-loader"><span></span><span></span><span></span><span></span></div>
    <div class="reload-overlay-text" id="reloadOverlayText">Обновляем…</div>
  </div>

</body>
</html>

<script>

  const ICO_CHANNEL = '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11v2a1 1 0 0 0 1 1h2l5 3V7L6 10H4a1 1 0 0 0-1 1z"/><path d="M14 9.5c1 .8 1.5 1.9 1.5 2.5s-.5 1.7-1.5 2.5"/><path d="M17 7c1.7 1.4 2.5 3.1 2.5 5s-.8 3.6-2.5 5"/></svg>';
  const ICO_WORLD = '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.8 3.8 5.8 3.8 9s-1.3 6.2-3.8 9c-2.5-2.8-3.8-5.8-3.8-9s1.3-6.2 3.8-9z"/></svg>';
  const ICO_GROUP = '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5h-1L5 22l1.2-3.5A8.5 8.5 0 1 1 21 11.5z"/></svg>';
  const ICO_SAVED = '<svg class="ico" viewBox="0 0 16 16" fill="currentColor"><path d="M9.828.722a.5.5 0 0 1 .354.146l4.95 4.95a.5.5 0 0 1 0 .707c-.48.48-1.072.588-1.503.588-.177 0-.335-.018-.46-.039l-3.134 3.134a5.927 5.927 0 0 1 .16 1.013c.046.702-.032 1.687-.72 2.375a.5.5 0 0 1-.707 0l-2.829-2.828-3.182 3.182c-.195.195-1.219.902-1.414.707-.195-.195.512-1.22.707-1.414l3.182-3.182-2.828-2.829a.5.5 0 0 1 0-.707c.688-.688 1.673-.767 2.375-.72a5.922 5.922 0 0 1 1.013.16l3.134-3.133a2.772 2.772 0 0 1-.04-.461c0-.43.108-1.022.589-1.503a.5.5 0 0 1 .353-.146zm.122 2.112v-.002.002zm0-.002v.002a.5.5 0 0 1-.122.51L6.293 6.878a.5.5 0 0 1-.511.12H5.78l-.014-.004a4.507 4.507 0 0 0-.288-.076 4.922 4.922 0 0 0-.765-.116c-.422-.028-.836.008-1.175.15l5.51 5.509c.141-.34.177-.753.149-1.175a4.924 4.924 0 0 0-.192-1.054l-.004-.013v-.001a.5.5 0 0 1 .12-.512l3.536-3.535a.5.5 0 0 1 .532-.115l.096.022c.087.017.208.034.344.034.114 0 .23-.011.343-.04L9.927 2.028c-.029.113-.04.23-.04.343a1.779 1.779 0 0 0 .062.46z"/></svg>';

  const API_BASE = 'https://freeunihomos.onrender.com';

  let currentUser = JSON.parse(localStorage.getItem('funh_user') || 'null');

  function api(path, options) {
    return fetch(API_BASE + path, options).then(async res => {
      let data = null;
      try { data = await res.json(); } catch (e) { data = null; }
      if (!res.ok) {
        let detail = data && data.detail;
        if (Array.isArray(detail)) detail = detail.map(x => x.msg || JSON.stringify(x)).join('; ');
        if (detail && typeof detail === 'object') detail = JSON.stringify(detail);
        throw new Error(detail || ('Ошибка сервера ' + res.status));
      }
      return data;
    });
  }

  function showScreen(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }
  function escapeHtml(s) {
    const d = document.createElement('div'); d.textContent = (s == null ? '' : s); return d.innerHTML;
  }

  function escapeJs(s) {
    return String(s == null ? '' : s)
      .replace(/\\/g, '\\\\')
      .replace(/'/g, "\\'")
      .replace(/"/g, '\\"')
      .replace(/\n/g, '\\n')
      .replace(/\r/g, '');
  }


  // ---- In-app dialogs (no native alert/confirm/prompt) ----
  let _dialogResolve = null;
  function showAppDialog({ title, body, input, textarea, defaultValue, okText, cancelText, danger }) {
    return new Promise(resolve => {
      _dialogResolve = resolve;
      document.getElementById('appDialogTitle').textContent = title || '';
      const bodyEl = document.getElementById('appDialogBody');
      bodyEl.textContent = body || '';
      bodyEl.style.display = body ? 'block' : 'none';
      const inp = document.getElementById('appDialogInput');
      const ta = document.getElementById('appDialogTextarea');
      inp.style.display = 'none'; ta.style.display = 'none';
      if (textarea) {
        ta.style.display = 'block'; ta.value = defaultValue || '';
        setTimeout(() => ta.focus(), 50);
      } else if (input) {
        inp.style.display = 'block'; inp.value = defaultValue || ''; inp.type = input === 'password' ? 'password' : 'text';
        setTimeout(() => inp.focus(), 50);
      }
      document.getElementById('appDialogOk').textContent = okText || 'OK';
      document.getElementById('appDialogCancel').textContent = cancelText || 'Отмена';
      document.getElementById('appDialogOk').classList.toggle('danger', !!danger);
      document.getElementById('appDialogCancel').style.display = (input || textarea || cancelText !== false) ? '' : 'none';
      if (cancelText === false && !input && !textarea) document.getElementById('appDialogCancel').style.display = 'none';
      document.getElementById('appDialogOverlay').classList.add('show');
    });
  }
  function closeAppDialog(result) {
    document.getElementById('appDialogOverlay').classList.remove('show');
    const r = _dialogResolve; _dialogResolve = null;
    if (r) r(result);
  }
  document.getElementById('appDialogCancel').addEventListener('click', () => closeAppDialog(null));
  document.getElementById('appDialogOk').addEventListener('click', () => {
    const inp = document.getElementById('appDialogInput');
    const ta = document.getElementById('appDialogTextarea');
    if (ta.style.display !== 'none') closeAppDialog(ta.value);
    else if (inp.style.display !== 'none') closeAppDialog(inp.value);
    else closeAppDialog(true);
  });
  document.getElementById('appDialogOverlay').addEventListener('click', (e) => {
    if (e.target.id === 'appDialogOverlay') closeAppDialog(null);
  });
  function appAlert(msg, title) {
    return showAppDialog({ title: title || 'Сообщение', body: msg, cancelText: false, okText: 'OK' });
  }
  function appConfirm(msg, title) {
    return showAppDialog({ title: title || 'Подтверждение', body: msg, okText: 'Да', cancelText: 'Отмена', danger: true }).then(v => !!v);
  }
  function appPrompt(msg, def, title) {
    return showAppDialog({ title: title || 'Ввод', body: msg, input: true, defaultValue: def || '', okText: 'OK', cancelText: 'Отмена' });
  }
  function appPromptText(msg, def, title) {
    return showAppDialog({ title: title || 'Редактирование', body: msg, textarea: true, defaultValue: def || '', okText: 'Сохранить', cancelText: 'Отмена' });
  }

  // ---- Pin storage (server, shared for everyone in the chat) ----
  let currentPin = null; // { message_id, preview, ... }

  function pinKindAndHandle() {
    if (!activeChat) return null;
    if (activeChat.kind === 'dm') return { kind: 'dm', chat_handle: activeChat.handle };
    if (activeChat.kind === 'entity') return { kind: 'entity', chat_handle: activeChat.handle };
    if (activeChat.kind === 'saved') return { kind: 'saved', chat_handle: currentUser.handle };
    return null;
  }

  function getPinnedId() {
    return currentPin && currentPin.message_id ? currentPin.message_id : null;
  }

  async function fetchPin() {
    const ph = pinKindAndHandle();
    if (!ph || !currentUser) { currentPin = null; updatePinnedBarUI(); return; }
    try {
      const q = '/pins/get?kind=' + encodeURIComponent(ph.kind)
        + '&chat_handle=' + encodeURIComponent(ph.chat_handle)
        + '&requester_handle=' + encodeURIComponent(currentUser.handle);
      const data = await api(q);
      currentPin = data && data.pinned ? data : null;
    } catch (e) {
      currentPin = null;
    }
    updatePinnedBarUI();
  }

  async function setPinnedId(id) {
    const ph = pinKindAndHandle();
    if (!ph || !currentUser) return;
    try {
      if (id) {
        const data = await api('/pins/set', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            kind: ph.kind,
            chat_handle: ph.chat_handle,
            message_id: id,
            requester_handle: currentUser.handle,
          })
        });
        currentPin = { message_id: id, preview: data.preview || '', msg_type: data.msg_type || 'text' };
      } else {
        await api('/pins/clear', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            kind: ph.kind,
            chat_handle: ph.chat_handle,
            message_id: '',
            requester_handle: currentUser.handle,
          })
        });
        currentPin = null;
      }
    } catch (err) {
      appAlert(friendlyError(err));
    }
    updatePinnedBarUI();
  }

  function updatePinnedBarUI() {
    const bar = document.getElementById('pinnedBar');
    if (!bar) return;
    if (!currentPin || !currentPin.message_id) {
      bar.classList.remove('show');
      return;
    }
    const preview = currentPin.preview || (currentPin.msg_type === 'photo' ? 'Фото' : currentPin.msg_type === 'voice' ? 'Голосове' : '');
    document.getElementById('pinnedBarPreview').textContent = preview;
    bar.classList.add('show');
  }

  // ---- Volume ----
  function loadVolume() {
    const v = parseInt(localStorage.getItem('funh_notif_volume') || '70', 10);
    return isNaN(v) ? 70 : Math.max(0, Math.min(100, v));
  }
  function applyVolumeUI(v) {
    const el = document.getElementById('notifVolume');
    const row = document.getElementById('volumeRow');
    const val = document.getElementById('notifVolumeVal');
    if (el) el.value = v;
    if (val) val.textContent = v + '%';
    if (row) row.style.setProperty('--vol-pct', v + '%');
    const a = document.getElementById('notifSound');
    if (a) a.volume = v / 100;
  }


  function nowTime() {
    const d = new Date();
    return String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
  }
  function avatarOrLetter(name, avatar) {
    if (avatar) return `<img src="${avatar}" style="width:100%;height:100%;border-radius:50%;object-fit:cover;">`;
    return (name || '?').charAt(0).toUpperCase();
  }
  function saveSession() { localStorage.setItem('funh_user', JSON.stringify(currentUser)); }

  // Notification sound (not for worldchat / groups)
  let notifVolume = parseFloat(localStorage.getItem('funh_notif_vol') || '0.7');
  let lastKnownUnreads = {};  // handle -> unread count
  function playNotifSound() {
    try {
      const a = document.getElementById('notifAudio');
      if (!a) return;
      a.volume = Math.max(0, Math.min(1, notifVolume));
      a.currentTime = 0;
      a.play().catch(() => {});
    } catch (e) {}
  }
  function checkAndPlayNotifs(conversations, myEntities) {
    // Only DMs and channels trigger sound — NOT worldchat, NOT groups (chat kind)
    const channelHandles = new Set((myEntities || []).filter(e => e.kind === 'channel').map(e => e.handle));
    (conversations || []).forEach(c => {
      const prev = lastKnownUnreads['dm:' + c.handle] || 0;
      const cur = c.unread || 0;
      if (cur > prev) playNotifSound();
      lastKnownUnreads['dm:' + c.handle] = cur;
    });
    // For channels we don't have unread counts from API easily — skip for now
    // (would need last message tracking). DMs are the main case.
  }


  // ---------------------------------------------------------------
  // AUTH TABS
  // ---------------------------------------------------------------
  const tabLogin = document.getElementById('tabLogin');
  const tabRegister = document.getElementById('tabRegister');
  tabLogin.addEventListener('click', () => {
    tabLogin.classList.add('active'); tabRegister.classList.remove('active');
    document.getElementById('panelLogin').classList.add('active');
    document.getElementById('panelRegister').classList.remove('active');
  });
  tabRegister.addEventListener('click', () => {
    tabRegister.classList.add('active'); tabLogin.classList.remove('active');
    document.getElementById('panelRegister').classList.add('active');
    document.getElementById('panelLogin').classList.remove('active');
  });

  const regName = document.getElementById('regName');
  const regHandle = document.getElementById('regHandle');
  const regPassword = document.getElementById('regPassword');
  const registerBtn = document.getElementById('registerBtn');
  const handleHint = document.getElementById('handleHint');

  function sanitizeHandle() {
    const raw = regHandle.value;
    const clean = raw.replace(/[^A-Za-z0-9_-]/g, '');
    regHandle.value = clean;
    handleHint.classList.toggle('error', clean !== raw);
  }
  function updateRegisterButton() {
    registerBtn.disabled = !(regName.value.trim().length >= 2 && regHandle.value.length >= 3 && regPassword.value.length >= 4);
  }
  regName.addEventListener('input', updateRegisterButton);
  regHandle.addEventListener('input', () => { sanitizeHandle(); updateRegisterButton(); });
  regPassword.addEventListener('input', updateRegisterButton);

  function goToLoading(label) {
    document.getElementById('loadingView').style.display = 'block';
    document.getElementById('resultView').style.display = 'none';
    document.getElementById('loadingText').textContent = label;
    showScreen('screenLoading');
  }
  function showResult(success, title, reason, onRetry) {
    document.getElementById('loadingView').style.display = 'none';
    document.getElementById('resultView').style.display = 'block';
    const icon = document.getElementById('resultIcon');
    icon.className = 'result-icon ' + (success ? 'ok' : 'fail');
    icon.textContent = success ? '✓' : '✕';
    document.getElementById('resultTitle').textContent = title;
    document.getElementById('resultReason').textContent = reason || '';
    const retryBtn = document.getElementById('resultRetryBtn');
    if (!success && onRetry) { retryBtn.style.display = 'block'; retryBtn.onclick = onRetry; }
    else { retryBtn.style.display = 'none'; }
    if (success) setTimeout(() => { enterApp(); }, 900);
  }
  
  const RESERVED_HANDLE_PREFIXES = ['voice', 'channel', 'groupe', 'chat'];
  function isReservedUserHandle(h) {
    h = (h || '').trim().replace(/^@/, '').toLowerCase();
    return RESERVED_HANDLE_PREFIXES.some(p => h === p || h.startsWith(p));
  }

function friendlyError(err) {
    if (err && err.message === 'Failed to fetch') {
      return 'Нет соединения с сервером. Возможно, он "спит" — подождите 40-50 секунд и попробуйте ещё раз.';
    }
    return (err && err.message) || 'Неизвестная ошибка. Попробуйте ещё раз.';
  }

  registerBtn.addEventListener('click', () => doRegister());
  function doRegister() {
    const h = regHandle.value.trim().replace(/^@/, '');
    if (isReservedUserHandle(h)) {
      document.getElementById('registerMsg').textContent = 'Хендл зарезервирован (не может начинаться с voice/channel/groupe/chat)';
      document.getElementById('registerMsg').className = 'form-msg error';
      return;
    }
    goToLoading('Регистрируем аккаунт...');
    api('/register', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: regName.value.trim(), handle: regHandle.value.trim(), password: regPassword.value })
    })
    .then(data => { currentUser = data; saveSession(); showResult(true, 'Готово!', 'Аккаунт создан.'); })
    .catch(err => showResult(false, 'Не получилось', friendlyError(err), doRegister));
  }

  document.getElementById('loginBtn').addEventListener('click', () => doLogin());
  function doLogin() {
    const identifier = document.getElementById('loginIdentifier').value.trim();
    const password = document.getElementById('loginPassword').value;
    if (!identifier || !password) {
      document.getElementById('loginMsg').textContent = 'Заполните оба поля';
      document.getElementById('loginMsg').className = 'form-msg error';
      return;
    }
    goToLoading('Входим в аккаунт...');
    api('/login', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ identifier, password })
    })
    .then(data => { currentUser = data; saveSession(); showResult(true, 'Готово!', 'Вход выполнен.'); })
    .catch(err => showResult(false, 'Не получилось', friendlyError(err), doLogin));
  }

  // ---------------------------------------------------------------
  // ENTER APP — first thing: sync with server by user_id so a handle
  // change made on another device is picked up (fixes the "split identity" bug)
  // ---------------------------------------------------------------
  let globalPollInterval = null;

  function enterApp() {
    showScreen('screenApp');
    // default tab: Home (Главная)
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.toggle('active', b.dataset.page === 'pageHome'));
    document.querySelectorAll('.tab-page').forEach(p => p.classList.toggle('active', p.id === 'pageHome'));
    api('/users/by-id/' + encodeURIComponent(currentUser.user_id))
      .then(fresh => { currentUser = fresh; saveSession(); renderProfile(); })
      .catch(() => { renderProfile(); });
    // rejoin world chat in case membership was lost
    api('/entities/join', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ handle: 'worldchat', member_handle: currentUser.handle })
    }).catch(() => {});
    lastChatListSignature = '';
    lastConversations = [];
    lastMyEntities = [];
    refreshChatList();
    refreshVoiceList();
    // volume slider
    const volEl = document.getElementById('notifVolume');
    const volVal = document.getElementById('notifVolumeVal');
    if (volEl) {
      volEl.value = Math.round(notifVolume * 100);
      if (volVal) volVal.textContent = volEl.value + '%';
      volEl.oninput = () => {
        notifVolume = volEl.value / 100;
        localStorage.setItem('funh_notif_vol', String(notifVolume));
        if (volVal) volVal.textContent = volEl.value + '%';
      };
    }
    if (!globalPollInterval) {
      globalPollInterval = setInterval(() => {
        api('/presence', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ handle: currentUser.handle })
        }).catch(() => {});
        api('/users/by-id/' + encodeURIComponent(currentUser.user_id))
          .then(fresh => { currentUser = fresh; saveSession(); })
          .catch(() => {});
        refreshChatList();
        if (!currentVoiceRoom) refreshVoiceList();
      }, 4000);
    }
  }

  document.querySelectorAll('.nav-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-page').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(btn.dataset.page).classList.add('active');
      if (btn.dataset.page === 'pageVoice' && !currentVoiceRoom) refreshVoiceList();
    });
  });

  // ---------------------------------------------------------------
  // CHATS TAB
  // ---------------------------------------------------------------
  let lastChatListSignature = '';

  let lastConversations = [];
  let lastMyEntities = [];

  function refreshChatList() {
    if (!currentUser) return;
    Promise.all([
      api('/conversations/' + encodeURIComponent(currentUser.handle)).then(d => Array.isArray(d) ? d : []).catch(err => {
        console.warn('conversations fail', err);
        return null; // null = network error, keep previous
      }),
      api('/entities/mine/' + encodeURIComponent(currentUser.handle)).then(d => Array.isArray(d) ? d : []).catch(err => {
        console.warn('entities fail', err);
        return null;
      }),
    ]).then(([conversations, myEntities]) => {
      // if request failed, keep previous list (don't wipe chats)
      if (conversations === null) conversations = lastConversations;
      else lastConversations = conversations;
      if (myEntities === null) myEntities = lastMyEntities;
      else lastMyEntities = myEntities;

      checkAndPlayNotifs(conversations, myEntities);
      // signature without huge fields
      const signature = JSON.stringify({
        c: (conversations || []).map(x => [x.handle, x.unread, x.last_time, x.online]),
        e: (myEntities || []).map(x => [x.handle, (x.members || []).length]),
      });
      if (signature === lastChatListSignature) return;
      lastChatListSignature = signature;
      renderChatList(conversations, myEntities);
    });
  }

  function renderChatList(conversations, myEntities) {
    const container = document.getElementById('chatListContainer');
    let html = '';

    // 1) Saved (Избранное)
    html += `
      <div class="chat-row" onclick="openSavedChat()">
        <div class="chat-avatar-wrap clickable-avatar" onclick="event.stopPropagation(); openUserProfile(currentUser && currentUser.handle)">
          <div class="chat-avatar saved"><svg class="ico" viewBox="0 0 16 16" fill="currentColor"><path d="M9.828.722a.5.5 0 0 1 .354.146l4.95 4.95a.5.5 0 0 1 0 .707c-.48.48-1.072.588-1.503.588-.177 0-.335-.018-.46-.039l-3.134 3.134a5.927 5.927 0 0 1 .16 1.013c.046.702-.032 1.687-.72 2.375a.5.5 0 0 1-.707 0l-2.829-2.828-3.182 3.182c-.195.195-1.219.902-1.414.707-.195-.195.512-1.22.707-1.414l3.182-3.182-2.828-2.829a.5.5 0 0 1 0-.707c.688-.688 1.673-.767 2.375-.72a5.922 5.922 0 0 1 1.013.16l3.134-3.133a2.772 2.772 0 0 1-.04-.461c0-.43.108-1.022.589-1.503a.5.5 0 0 1 .353-.146zm.122 2.112v-.002.002zm0-.002v.002a.5.5 0 0 1-.122.51L6.293 6.878a.5.5 0 0 1-.511.12H5.78l-.014-.004a4.507 4.507 0 0 0-.288-.076 4.922 4.922 0 0 0-.765-.116c-.422-.028-.836.008-1.175.15l5.51 5.509c.141-.34.177-.753.149-1.175a4.924 4.924 0 0 0-.192-1.054l-.004-.013v-.001a.5.5 0 0 1 .12-.512l3.536-3.535a.5.5 0 0 1 .532-.115l.096.022c.087.017.208.034.344.034.114 0 .23-.011.343-.04L9.927 2.028c-.029.113-.04.23-.04.343a1.779 1.779 0 0 0 .062.46z"/></svg></div>
        </div>
        <div class="chat-info">
          <div class="chat-name">${t('saved')}</div>
          <div class="chat-sub">${t('saved_sub')}</div>
        </div>
      </div>`;

    const onlinePeople = (conversations || []).filter(c => c.online).sort((a,b) => (b.unread||0)-(a.unread||0));
    const offlinePeople = (conversations || []).filter(c => !c.online).sort((a,b) => (b.unread||0)-(a.unread||0));
    const channels = (myEntities || []).filter(e => e.kind === 'channel');
    const groups = (myEntities || []).filter(e => (e.kind === 'groupe' || e.kind === 'chat') && e.handle !== 'worldchat');
    const world = (myEntities || []).find(e => e.handle === 'worldchat');

    // 2) World chat
    if (world) {
      html += `
      <div class="chat-row" onclick="openEntityByHandle('worldchat', 'chat')">
        <div class="chat-avatar" style="background:linear-gradient(135deg,#3d8b6e,#2a6b52);">${ICO_WORLD}</div>
        <div class="chat-info">
          <div class="chat-name">${escapeHtml(world.name || t('world'))}</div>
          <div class="chat-sub">${t('world_sub')}</div>
        </div>
      </div>`;
    }

    function personRow(c) {
      return `
      <div class="chat-row" onclick="openDmChat('${escapeJs(c.handle)}', '${escapeJs(c.name)}')">
        <div class="chat-avatar-wrap clickable-avatar" onclick="event.stopPropagation(); openUserProfile('${escapeJs(c.handle)}')">
          <div class="chat-avatar">${avatarOrLetter(c.name, c.avatar)}</div>
          ${c.online ? '<div class="online-dot"></div>' : ''}
        </div>
        <div class="chat-info">
          <div class="chat-name">${escapeHtml(c.name)}${c.tag_emoji ? ' ' + c.tag_emoji : ''}</div>
          <div class="chat-sub">${c.last_type === 'text' ? escapeHtml(c.last_content_preview) : (c.last_type === 'photo' ? t('photo') : t('voice_msg'))}</div>
        </div>
        <div class="chat-meta" style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
          <div class="chat-time">${escapeHtml(c.last_time || '')}</div>
          ${c.unread ? `<div class="unread-badge">${c.unread}</div>` : ''}
        </div>
      </div>`;
    }

    // 3) Online people
    if (onlinePeople.length) {
      html += `<div class="section-header">${t('online')}</div>`;
      onlinePeople.forEach(c => { html += personRow(c); });
    }

    // 4) Channels
    if (channels.length) {
      html += `<div class="section-header">${t('channels')}</div>`;
      channels.forEach(e => {
        html += `
        <div class="chat-row" onclick="openEntityByHandle('${escapeJs(e.handle)}', 'channel')">
          <div class="chat-avatar">${ICO_CHANNEL}</div>
          <div class="chat-info">
            <div class="chat-name">${escapeHtml(e.name)}</div>
            <div class="chat-sub">@${escapeHtml(e.handle)}</div>
          </div>
        </div>`;
      });
    }

    // 4b) Groups
    if (groups.length) {
      html += `<div class="section-header">${t('groups')}</div>`;
      groups.forEach(e => {
        html += `
        <div class="chat-row" onclick="openEntityByHandle('${escapeJs(e.handle)}', 'groupe')">
          <div class="chat-avatar">${ICO_GROUP}</div>
          <div class="chat-info">
            <div class="chat-name">${escapeHtml(e.name)}</div>
            <div class="chat-sub">@${escapeHtml(e.handle)}</div>
          </div>
        </div>`;
      });
    }

    // 5) Offline people
    if (offlinePeople.length) {
      html += `<div class="section-header">${t('people_offline')}</div>`;
      offlinePeople.forEach(c => { html += personRow(c); });
    }

    container.innerHTML = html;
  }

  // ---------------------------------------------------------------
  // ACTIVE CHAT + polling
  // ---------------------------------------------------------------
  let activeChat = null;   // { kind: 'saved' | 'dm' | 'entity', handle, name }
  let chatFetchToken = 0;
  const messagesCache = {}; // key -> { list, ts }
  function chatCacheKey(chat) {
    if (!chat) return '';
    if (chat.kind === 'dm') return 'dm:' + chat.handle;
    if (chat.kind === 'entity') return 'entity:' + chat.handle;
    if (chat.kind === 'saved') return 'saved:' + (currentUser && currentUser.handle);
    return chat.kind + ':' + chat.handle;
  }

  let chatPollInterval = null;
  let lastMessagesSignature = '';
  let pendingReply = null; // { message_id, preview }

  function stopChatPolling() {
    if (chatPollInterval) { clearInterval(chatPollInterval); chatPollInterval = null; }
    lastMessagesSignature = '';
  }

  document.getElementById('chatBackBtn').addEventListener('click', () => {
    stopChatPolling();
    activeChat = null;
    clearReply();
    showScreen('screenApp');
    refreshChatList();
  });

  function openSavedChat() { openChatCommon({ kind: 'saved', handle: currentUser.handle, name: 'Избранное' }); }
  function openDmChat(otherHandle, otherName) { openChatCommon({ kind: 'dm', handle: otherHandle, name: otherName }); }
  window.openDmChat = openDmChat;
  window.openSavedChat = openSavedChat;
  window.openEntityByHandle = openEntityByHandle;
  window.openWorldChat = openWorldChat;
  function openWorldChat() {
    openEntityByHandle('worldchat', 'chat');
  }

  function openChatCommon(chat) {
    activeChat = chat;
    chatFetchToken += 1;
    clearReply();
    lastMessagesSignature = null;
    allMessagesCache = [];
    visibleCount = MSG_PAGE;
    loadingOlder = false;
    currentPin = null;
    updatePinnedBarUI();
    fetchPin();
    document.getElementById('chatHeaderName').textContent = chat.name;
    document.getElementById('chatHeaderAvatar').style.display = 'none';
    document.getElementById('chatHeaderSub').style.display = 'none';
    document.getElementById('pinnedBar').classList.remove('show');
    updateChatHeader(chat);
    // show cached messages instantly if any
    const ck = chatCacheKey(chat);
    const cached = messagesCache[ck];
    if (cached && cached.list && cached.list.length) {
      allMessagesCache = cached.list.slice();
      visibleCount = Math.min(MSG_PAGE, allMessagesCache.length);
      renderMessagesWindow(true);
    } else {
      document.getElementById('messagesArea').innerHTML = bounceLoaderHtml();
    }
    showScreen('screenChat');
    pollActiveChat(true);
    if (chatPollInterval) clearInterval(chatPollInterval);
    chatPollInterval = setInterval(() => pollActiveChat(false), 3000);
    if (typeof applyChatBackground === 'function') applyChatBackground();
  }

  function formatLastSeen(ts) {
    if (!ts) return 'не в сети';
    const now = Date.now() / 1000;
    if (now - ts < 120) return 'в сети';
    const d = new Date(ts * 1000);
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    const today = new Date();
    if (d.toDateString() === today.toDateString()) return 'был(а) в сети в ' + hh + ':' + mm;
    const dd = String(d.getDate()).padStart(2, '0');
    const mo = String(d.getMonth() + 1).padStart(2, '0');
    return 'был(а) в сети ' + dd + '.' + mo + ' в ' + hh + ':' + mm;
  }

  function updateChatHeader(chat) {
    const av = document.getElementById('chatHeaderAvatar');
    const sub = document.getElementById('chatHeaderSub');
    const nameEl = document.getElementById('chatHeaderName');
    nameEl.onclick = null;
    nameEl.style.cursor = '';
    av.onclick = null;
    av.style.display = 'flex';
    if (chat.kind === 'dm') {
      api('/users/' + encodeURIComponent(chat.handle)).then(u => {
        if (!activeChat || activeChat.handle !== chat.handle) return;
        av.style.background = 'linear-gradient(135deg, var(--tag), #3a63c9)';
        av.innerHTML = '<div class="chat-avatar-wrap" style="width:100%;height:100%;">' + avatarOrLetter(u.name, u.avatar) + (u.online ? '<div class="online-dot"></div>' : '') + '</div>';
        av.onclick = () => openUserProfile(chat.handle);
        const nc = (u.name_color && u.name_color.trim()) ? u.name_color : '#ffffff';
        nameEl.innerHTML = `<span style="color:${nc}">${escapeHtml(u.name)}</span>${u.tag_emoji ? ' ' + u.tag_emoji : ''}`;
        nameEl.style.cursor = 'pointer';
        nameEl.onclick = () => openUserProfile(chat.handle);
        sub.style.display = 'block';
        sub.textContent = u.online ? 'в сети' : formatLastSeen(u.last_seen);
        sub.classList.toggle('online', !!u.online);
      }).catch(() => {});
    } else if (chat.kind === 'entity') {
      api('/entities/' + encodeURIComponent(chat.handle)).then(e => {
        if (!activeChat || activeChat.handle !== chat.handle) return;
        const members = e.members || [];
        let kindIcon = ICO_GROUP;
        let bg = 'linear-gradient(135deg, var(--tag), #3a63c9)';
        if (e.handle === 'worldchat' || e.is_world) {
          kindIcon = ICO_WORLD;
          bg = 'linear-gradient(135deg,#3d8b6e,#2a6b52)';
        } else if (e.kind === 'channel') {
          kindIcon = ICO_CHANNEL;
          bg = 'linear-gradient(135deg, var(--tag), #3a63c9)';
        } else if (e.kind === 'voice') {
          kindIcon = '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v4"/><path d="M8 22h8"/></svg>';
          bg = 'linear-gradient(135deg, #9b6fd4, #6f3fbf)';
        } else if (e.kind === 'groupe' || e.kind === 'chat') {
          kindIcon = ICO_GROUP;
        }
        av.style.background = bg;
        av.innerHTML = kindIcon;
        av.onclick = () => openEntityProfile(e.handle);
        nameEl.textContent = e.name;
        nameEl.style.cursor = 'pointer';
        nameEl.onclick = () => openEntityProfile(e.handle);
        const handles = members.slice(0, 40);
        if (!handles.length) {
          sub.style.display = 'block';
          sub.textContent = '0 участн.';
          return;
        }
        Promise.all(handles.map(h => api('/users/' + encodeURIComponent(h)).catch(() => null))).then(list => {
          if (!activeChat || activeChat.handle !== chat.handle) return;
          const online = list.filter(u => u && u.online).length;
          const total = members.length;
          sub.style.display = 'block';
          sub.textContent = total + ' участн. · ' + online + ' онлайн · ' + (total - online) + ' офлайн';
        });
      }).catch(() => {});
    } else if (chat.kind === 'saved') {
      // same gradient as list, pin icon white
      av.style.background = 'linear-gradient(135deg, #f2a65a, #d88f45)';
      av.innerHTML = ICO_SAVED;
      av.onclick = (ev) => { ev && ev.stopPropagation(); openUserProfile(currentUser && currentUser.handle); };
      nameEl.textContent = t('saved');
      nameEl.style.cursor = 'pointer';
      nameEl.onclick = () => openUserProfile(currentUser && currentUser.handle);
      sub.style.display = 'none';
    }
  }

  function updatePinnedBar(msgs) {
    if (!currentPin || !currentPin.message_id) {
      updatePinnedBarUI();
      return;
    }
    const msg = (msgs || allMessagesCache || currentMessagesList || []).find(m => m.message_id === currentPin.message_id);
    if (msg) {
      if (msg.type === 'text') currentPin.preview = msg.content;
      else if (msg.type === 'photo') currentPin.preview = 'Фото';
      else if (msg.type === 'voice') currentPin.preview = 'Голосове';
    }
    updatePinnedBarUI();
  }

  function openEntityByHandle(handle, kind) {
    api('/entities/join', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ handle, member_handle: currentUser.handle })
    }).then(entity => {
      if (kind === 'voice') { joinVoiceRoomUI(entity); return; }
      openChatCommon({ kind: 'entity', handle: entity.handle, name: entity.name });
    }).catch(err => appAlert(friendlyError(err)));
  }

  const MSG_PAGE = 40;
  let allMessagesCache = [];
  let visibleCount = MSG_PAGE;
  let loadingOlder = false;
  let currentMessagesList = [];

  function bounceLoaderHtml() {
    return '<div class="bounce-loader" id="chatBounceLoader"><span></span><span></span><span></span><span></span></div>';
  }

  function pollActiveChat(forceScroll) {
    if (!activeChat) return;
    const myToken = chatFetchToken;
    const myChat = activeChat;
    const myKey = chatCacheKey(myChat);
    const isFirst = lastMessagesSignature === null;
    if (isFirst) {
      const area = document.getElementById('messagesArea');
      if (area && !area.querySelector('.msg-row') && !area.querySelector('.bounce-loader') && !(messagesCache[myKey] && messagesCache[myKey].list && messagesCache[myKey].list.length)) {
        area.innerHTML = bounceLoaderHtml();
      }
    }
    let request;
    if (myChat.kind === 'saved') {
      request = api('/saved/' + encodeURIComponent(currentUser.handle)).then(list => list.map(m => ({ ...m, mine: true })));
    } else if (myChat.kind === 'dm') {
      request = api('/messages/' + encodeURIComponent(currentUser.handle) + '/' + encodeURIComponent(myChat.handle))
        .then(list => {
          if (activeChat && activeChat.handle === myChat.handle) {
            api('/messages/mark_read', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ reader_handle: currentUser.handle, other_handle: myChat.handle })
            }).catch(() => {});
          }
          return list.map(m => ({ ...m, mine: m.from_handle === currentUser.handle }));
        });
    } else {
      request = api('/entities/messages/' + encodeURIComponent(myChat.handle))
        .then(list => list.map(m => ({ ...m, mine: m.from_handle === currentUser.handle })));
    }

    request.then(list => {
      // race guard: ignore if user switched chat
      if (myToken !== chatFetchToken) return;
      if (!activeChat || chatCacheKey(activeChat) !== myKey) return;
      // always update cache
      messagesCache[myKey] = { list: list, ts: Date.now() };
      const signature = list.map(m => m.message_id + ':' + (m.edited ? '1' : '0') + ':' + (m.status || '') + ':' + (m.content || '').length).join('|');
      if (signature === lastMessagesSignature && !forceScroll) return;
      const wasAtBottom = isScrolledNearBottom();
      const prevLen = allMessagesCache.length;
      lastMessagesSignature = signature;
      allMessagesCache = list;
      if (isFirst || prevLen === 0) {
        visibleCount = Math.min(MSG_PAGE, list.length);
      } else {
        const grew = list.length - prevLen;
        if (grew > 0) visibleCount = Math.min(list.length, visibleCount + grew);
        else visibleCount = Math.min(list.length, Math.max(visibleCount, Math.min(MSG_PAGE, list.length)));
      }
      renderMessagesWindow(forceScroll !== false || wasAtBottom || isFirst);
    }).catch(() => {
      if (myToken !== chatFetchToken) return;
      const area = document.getElementById('messagesArea');
      if (area && area.querySelector('.bounce-loader')) {
        area.innerHTML = '<div style="text-align:center;color:var(--err);font-size:13px;padding:20px;">Ошибка загрузки</div>';
      }
    });
  }


  function isScrolledNearBottom() {
    const area = document.getElementById('messagesArea');
    if (!area) return true;
    return area.scrollHeight - area.scrollTop - area.clientHeight < 80;
  }

  function getVisibleMessages() {
    const n = allMessagesCache.length;
    const start = Math.max(0, n - visibleCount);
    return allMessagesCache.slice(start);
  }

  function renderMessagesWindow(scrollToBottom) {
    const msgs = getVisibleMessages();
    currentMessagesList = msgs;
    const area = document.getElementById('messagesArea');
    const hasMore = visibleCount < allMessagesCache.length;
    let html = '';
    if (hasMore) {
      html += '<div class="chat-loading-more" id="loadOlderHint">Листай вверх за старыми…</div>';
    }
    if (!msgs.length) {
      html += '<div style="text-align:center;color:var(--text-muted);font-size:13px;padding:20px;">Ще нет сообщений</div>';
    } else {
      html += msgs.map(renderBubble).join('');
    }
    const prevHeight = area.scrollHeight;
    const prevTop = area.scrollTop;
    area.innerHTML = html;
    updatePinnedBar(allMessagesCache);
    bindLongPress(area);
    if (scrollToBottom) {
      area.scrollTop = area.scrollHeight;
    } else if (!scrollToBottom && prevHeight) {
      // preserve position when prepending older
      area.scrollTop = area.scrollHeight - prevHeight + prevTop;
    }
  }

  // legacy alias
  function renderMessages(msgs, scrollToBottom) {
    allMessagesCache = msgs;
    visibleCount = Math.min(MSG_PAGE, msgs.length);
    renderMessagesWindow(scrollToBottom);
  }

  function loadOlderMessages() {
    if (loadingOlder) return;
    if (visibleCount >= allMessagesCache.length) return;
    loadingOlder = true;
    const area = document.getElementById('messagesArea');
    const hint = document.getElementById('loadOlderHint');
    if (hint) hint.innerHTML = bounceLoaderHtml();
    // small delay so animation is visible
    setTimeout(() => {
      const prevHeight = area.scrollHeight;
      const prevTop = area.scrollTop;
      visibleCount = Math.min(allMessagesCache.length, visibleCount + MSG_PAGE);
      renderMessagesWindow(false);
      area.scrollTop = area.scrollHeight - prevHeight + prevTop;
      loadingOlder = false;
    }, 200);
  }

  // scroll-up to load older
  (function bindMsgScroll() {
    const area = document.getElementById('messagesArea');
    if (!area) return;
    area.addEventListener('scroll', () => {
      if (area.scrollTop < 80) loadOlderMessages();
    }, { passive: true });
  })();


  function renderBubble(m) {
    let inner = '';
    if (m.type === 'text') inner = `<div>${escapeHtml(m.content)}</div>`;
    else if (m.type === 'photo') inner = `<img src="${m.content}">`;
    else if (m.type === 'voice') inner = `
        <button class="voice-play-btn" onclick="event.stopPropagation(); playVoice(this)" data-src="${m.content}"><svg class="ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
        <div class="waveform">${voiceBars()}</div>
        <span style="font-size:11px;">${escapeHtml(m.duration || '')}</span>`;

    const incoming = m.mine === false;
    const ticks = m.status === 'sending' ? '<span class="ticks pending">…</span>'
                : m.status === 'read' ? '<span class="ticks">✓✓</span>'
                : '<span class="ticks">✓</span>';

    let senderRow = '';
    // Show sender name in DM (for clarity) and entities
    if (activeChat && activeChat.kind === 'dm') {
      const nm = incoming ? (activeChat.name || m.from_handle || '') : (currentUser.name || '');
      const fh = incoming ? activeChat.handle : currentUser.handle;
      if (nm) {
        senderRow = `<div class="msg-sender-row">
          <div class="msg-sender-name" style="color:${incoming ? '#ffffff' : 'rgba(26,18,0,0.65)'};">${escapeHtml(nm)}</div>
        </div>`;
      }
    } else if (activeChat && activeChat.kind === 'entity' && m.from_name) {
      const fh = m.from_handle || '';
      senderRow = `<div class="msg-sender-row">
        <div class="msg-sender-avatar clickable-avatar" onclick="event.stopPropagation(); openUserProfile('${escapeHtml(fh)}')">${avatarOrLetter(m.from_name, m.from_avatar)}</div>
        <div class="msg-sender-name clickable-avatar" onclick="event.stopPropagation(); openUserProfile('${escapeJs(fh)}')" style="color:${(m.from_name_color && m.from_name_color.trim()) ? m.from_name_color : '#ffffff'}">${escapeHtml(m.from_name)}${m.from_tag_emoji ? ' ' + m.from_tag_emoji : ''}</div>
      </div>`;
    }

    let forwardedTag = m.forwarded_from ? `<div class="msg-forwarded-tag">Переслано от @${escapeHtml(m.forwarded_from)}</div>` : '';
    let replyQuote = m.reply_preview ? `<div class="msg-reply-quote">${escapeHtml(m.reply_preview)}</div>` : '';
    let editedTag = m.edited ? ' <span style="opacity:0.6;">(ред.)</span>' : '';

    const replyIco = '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg>';
    const editIco = '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>';

    let sideBtn = '';
    if (incoming) {
      sideBtn = `<button class="msg-side-btn" title="Ответить" onclick="event.stopPropagation(); quickReply('${m.message_id}')">${replyIco}</button>`;
    } else if (m.type === 'text') {
      sideBtn = `<button class="msg-side-btn" title="Редактировать" onclick="event.stopPropagation(); quickEdit('${m.message_id}')">${editIco}</button>`;
    }

    const bubbleStyle = incoming ? 'background:var(--panel-2);color:var(--text);' : '';
    // Name ABOVE the bubble (especially for voice)
    return `<div class="msg-row ${incoming ? 'incoming' : ''}" data-mid="${m.message_id}">
      ${senderRow}
      <div class="msg-bubble-wrap">
        <div class="msg-bubble ${m.type === 'photo' ? 'photo' : ''} ${m.type === 'voice' ? 'voice' : ''}"
          style="${bubbleStyle}"
          data-mid="${m.message_id}">
          ${forwardedTag}${replyQuote}
          ${inner}
          <div class="msg-meta" ${incoming ? 'style="justify-content:flex-start;color:var(--text-muted);"' : ''}><span class="msg-time">${escapeHtml(m.time)}${editedTag}</span>${incoming ? '' : ticks}</div>
        </div>
        ${sideBtn}
      </div>
    </div>`;
  }

  function bindLongPress(area) {
    let timer = null, startX = 0, startY = 0, targetMid = null;
    area.querySelectorAll('.msg-bubble').forEach(el => {
      const mid = el.dataset.mid;
      const start = (e) => {
        const t = e.touches ? e.touches[0] : e;
        startX = t.clientX; startY = t.clientY;
        targetMid = mid;
        timer = setTimeout(() => {
          timer = null;
          openMessageActions(mid);
        }, 500);
      };
      const cancel = (e) => {
        if (timer) {
          clearTimeout(timer); timer = null;
        }
      };
      const move = (e) => {
        if (!timer) return;
        const t = e.touches ? e.touches[0] : e;
        if (Math.abs(t.clientX - startX) > 12 || Math.abs(t.clientY - startY) > 12) cancel();
      };
      el.addEventListener('touchstart', start, { passive: true });
      el.addEventListener('touchend', cancel);
      el.addEventListener('touchmove', move, { passive: true });
      el.addEventListener('mousedown', start);
      el.addEventListener('mouseup', cancel);
      el.addEventListener('mouseleave', cancel);
      el.addEventListener('contextmenu', (e) => { e.preventDefault(); openMessageActions(mid); });
    });
  }

  window.quickReply = function(messageId) {
    const msg = currentMessagesList.find(m => m.message_id === messageId);
    if (msg) startReply(msg);
  };
  window.quickEdit = function(messageId) {
    const msg = currentMessagesList.find(m => m.message_id === messageId);
    if (msg) startEdit(msg);
  };

  function voiceBars() {
    let s = '';
    for (let i = 0; i < 18; i++) s += `<span style="height:${6 + Math.round(Math.random() * 14)}px;"></span>`;
    return s;
  }
  const PLAY_ICO = '<svg class="ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
  const PAUSE_ICO = '<svg class="ico" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>';
  let activeVoice = null;
  const voicePositions = {};
  const VOICE_POS_TTL = 3 * 60 * 1000;

  function voiceKey(btn) {
    const row = btn.closest('[data-mid]');
    return (row && row.dataset.mid) || btn.dataset.src.slice(0, 80);
  }

  function playVoice(btn) {
    const src = btn.dataset.src;
    if (!src) return;
    const key = voiceKey(btn);
    // toggle pause/resume on same voice
    if (activeVoice && activeVoice.key === key && activeVoice.audio) {
      const a = activeVoice.audio;
      if (!a.paused) {
        a.pause();
        voicePositions[key] = { t: a.currentTime, savedAt: Date.now() };
        btn.innerHTML = PLAY_ICO;
        return;
      }
      a.play().catch(() => {});
      btn.innerHTML = PAUSE_ICO;
      return;
    }
    // stop any other playing voice
    if (activeVoice && activeVoice.audio) {
      try {
        activeVoice.audio.pause();
        voicePositions[activeVoice.key] = { t: activeVoice.audio.currentTime, savedAt: Date.now() };
        if (activeVoice.btn) activeVoice.btn.innerHTML = PLAY_ICO;
      } catch (e) {}
    }
    const audio = new Audio(src);
    const pos = voicePositions[key];
    if (pos && (Date.now() - pos.savedAt) < VOICE_POS_TTL) {
      const apply = () => { try { audio.currentTime = pos.t || 0; } catch (e) {} };
      if (audio.readyState >= 1) apply();
      else audio.addEventListener('loadedmetadata', apply, { once: true });
    }
    activeVoice = { audio, btn, src, key };
    btn.innerHTML = PAUSE_ICO;
    audio.play().catch(() => { btn.innerHTML = PLAY_ICO; });
    audio.onended = () => {
      btn.innerHTML = PLAY_ICO;
      delete voicePositions[key];
      if (activeVoice && activeVoice.key === key) activeVoice = null;
    };
  }

