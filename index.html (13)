  function startDmWith(handle, name) {
    document.getElementById('homeSearchInput').value = '';
    document.getElementById('homeSearchResults').innerHTML = '';
    openDmChat(handle, name);
  }

  // ---------------------------------------------------------------
  // VOICE TAB (list + room UI with speakers, ephemeral emoji/text)
  // ---------------------------------------------------------------
  let isTalking = false, isMuted = false, currentVoiceRoom = null, voiceStream = null;
  let voicePollInterval = null;
  let lastVoiceStateSig = '';

  function refreshVoiceList() {
    api('/entities/voices/list').then(list => {
      const container = document.getElementById('voiceListContainer');
      if (!list || !list.length) {
        container.innerHTML = `<div class="empty-state"><div class="empty-emoji"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v4"/><path d="M8 22h8"/></svg></div><div>Нет активных войсов</div><div style="font-size:12.5px;">Создайте войс на главной</div></div>`;
        return;
      }
      let html = '';
      list.forEach(v => {
        html += `
        <div class="chat-row" onclick="openEntityByHandle('${escapeHtml(v.handle)}', 'voice')">
          <div class="chat-avatar voice"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v4"/><path d="M8 22h8"/></svg></div>
          <div class="chat-info">
            <div class="chat-name">${escapeHtml(v.name)}</div>
            <div class="chat-sub">@${escapeHtml(v.handle)}</div>
          </div>
          <div class="chat-meta">
            <div class="chat-time">${v.member_count}/${v.max_members}</div>
            ${v.talking_count ? `<div style="font-size:11px;color:var(--ok);">говорять: ${v.talking_count}</div>` : ''}
          </div>
        </div>`;
      });
      container.innerHTML = html;
    }).catch(() => {});
  }

  function joinVoiceRoomUI(entity) {
    currentVoiceRoom = entity;
    isTalking = false; isMuted = false;
    lastVoiceStateSig = '';
    document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-page').forEach(p => p.classList.remove('active'));
    document.querySelector('.nav-btn[data-page="pageVoice"]').classList.add('active');
    document.getElementById('pageVoice').classList.add('active');
    document.getElementById('voiceListView').style.display = 'none';
    document.getElementById('voiceRoomView').style.display = 'flex';
    document.getElementById('voiceRoomName').textContent = entity.name;
    document.getElementById('voiceRoomHandle').textContent = '@' + entity.handle;
    document.getElementById('talkBtn').classList.remove('active');
    document.getElementById('muteBtn').classList.remove('active');
    document.getElementById('voiceEmojiBar').classList.remove('show');
    document.getElementById('voiceTextRow').classList.remove('show');
    pollVoiceState();
    if (voicePollInterval) clearInterval(voicePollInterval);
    voicePollInterval = setInterval(pollVoiceState, 2500);
    navigator.mediaDevices.getUserMedia({ audio: true })
      .then(stream => {
        voiceStream = stream;
        voiceStream.getAudioTracks().forEach(t => t.enabled = false);
      })
      .catch(() => { /* mic optional — can still send emoji/text */ });
  }

  function pollVoiceState() {
    if (!currentVoiceRoom) return;
    api('/entities/voice/state/' + encodeURIComponent(currentVoiceRoom.handle))
      .then(state => {
        const sig = JSON.stringify(state);
        if (sig === lastVoiceStateSig) return;
        lastVoiceStateSig = sig;
        renderVoiceMembers(state);
      }).catch(() => {});
  }

  function renderVoiceMembers(state) {
    const list = document.getElementById('voiceMembersList');
    const members = state.members || [];
    // talking first
    members.sort((a, b) => (b.talking ? 1 : 0) - (a.talking ? 1 : 0));
    let html = '';
    members.forEach(m => {
      const eph = (state.ephemeral || []).filter(e => e.from_handle === m.handle);
      const ephHtml = eph.map(e => e.kind === 'emoji' ? `<span class="vm-eph">${escapeHtml(e.content)}</span>` : `<span class="vm-eph" style="font-size:12px;"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5h-1L5 22l1.2-3.5A8.5 8.5 0 1 1 21 11.5z"/></svg></span>`).join('');
      html += `
      <div class="voice-member-row ${m.talking ? 'talking' : ''}">
        <div class="vm-avatar">${avatarOrLetter(m.name, m.avatar)}</div>
        <div class="vm-info">
          <div class="vm-name">${escapeHtml(m.name)}${m.tag_emoji ? ' ' + m.tag_emoji : ''} ${ephHtml}</div>
          <div class="vm-handle">@${escapeHtml(m.handle)}</div>
        </div>
        <div class="vm-status ${m.talking ? 'speaking' : ''}">${m.talking ? 'Говорить' : 'Мовчить'}</div>
      </div>`;
    });
    list.innerHTML = html || '<div style="text-align:center;color:var(--text-muted);padding:20px;">Никого нет</div>';
    document.getElementById('voiceCount').textContent = `людей в войсе: ${members.length}/${state.max_members || 10}`;

    // ephemeral feed
    const feed = document.getElementById('voiceEphFeed');
    const ephs = state.ephemeral || [];
    if (ephs.length) {
      feed.innerHTML = ephs.map(e => {
        if (e.kind === 'emoji') return `<div class="voice-eph-item"><strong>${escapeHtml(e.from_name)}</strong> ${escapeHtml(e.content)}</div>`;
        return `<div class="voice-eph-item"><strong>${escapeHtml(e.from_name)}</strong>: ${escapeHtml(e.content)}</div>`;
      }).join('');
    } else {
      feed.innerHTML = '';
    }
  }

  document.getElementById('talkBtn').addEventListener('click', function() {
    if (!currentVoiceRoom) return;
    isTalking = !isTalking;
    this.classList.toggle('active', isTalking);
    if (voiceStream) voiceStream.getAudioTracks().forEach(t => t.enabled = isTalking && !isMuted);
    api('/entities/voice/talk', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ handle: currentVoiceRoom.handle, member_handle: currentUser.handle, talking: isTalking })
    }).catch(() => {});
  });
  document.getElementById('muteBtn').addEventListener('click', function() {
    isMuted = !isMuted;
    this.classList.toggle('active', isMuted);
    if (voiceStream) voiceStream.getAudioTracks().forEach(t => t.enabled = isTalking && !isMuted);
  });
  document.getElementById('leaveVoiceBtn').addEventListener('click', () => {
    if (voiceStream) { voiceStream.getTracks().forEach(t => t.stop()); voiceStream = null; }
    if (voicePollInterval) { clearInterval(voicePollInterval); voicePollInterval = null; }
    if (currentVoiceRoom) {
      api('/entities/voice/talk', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ handle: currentVoiceRoom.handle, member_handle: currentUser.handle, talking: false })
      }).catch(() => {});
      api('/entities/leave', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ handle: currentVoiceRoom.handle, member_handle: currentUser.handle })
      }).catch(() => {});
    }
    currentVoiceRoom = null; isTalking = false; isMuted = false;
    document.getElementById('voiceListView').style.display = 'block';
    document.getElementById('voiceRoomView').style.display = 'none';
    refreshVoiceList();
  });

  document.getElementById('emojiToggleBtn').addEventListener('click', () => {
    document.getElementById('voiceEmojiBar').classList.toggle('show');
    document.getElementById('voiceTextRow').classList.remove('show');
  });
  document.querySelectorAll('#voiceEmojiBar span').forEach(span => {
    span.addEventListener('click', () => {
      const e = span.dataset.e;
      if (e === 'text') {
        document.getElementById('voiceTextRow').classList.add('show');
        document.getElementById('voiceTextInput').focus();
        return;
      }
      sendVoiceEphemeral(e, 'emoji');
      document.getElementById('voiceEmojiBar').classList.remove('show');
    });
  });
  document.getElementById('voiceTextSend').addEventListener('click', () => {
    const t = document.getElementById('voiceTextInput').value.trim();
    if (!t) return;
    sendVoiceEphemeral(t.slice(0, 100), 'text');
    document.getElementById('voiceTextInput').value = '';
    document.getElementById('voiceTextRow').classList.remove('show');
    document.getElementById('voiceEmojiBar').classList.remove('show');
  });

  function sendVoiceEphemeral(content, kind) {
    if (!currentVoiceRoom) return;
    api('/entities/voice/ephemeral', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ entity_handle: currentVoiceRoom.handle, from_handle: currentUser.handle, content, kind })
    }).then(() => pollVoiceState()).catch(err => appAlert(friendlyError(err)));
  }

  // ---------------------------------------------------------------
  // PROFILE TAB + POSTS
  // ---------------------------------------------------------------
  const REACTION_MAP = { like: '👍', heart: '❤️', dislike: '👎', fire: '🔥' };
  let pendingPostPhoto = '';
  let activeCommentsPostId = null;
  let activeCommentsAllow = true;
  let activeCommentsIsOwner = false;

  function renderProfile() {
    if (!currentUser) return;
    document.getElementById('profileAvatarLetter').innerHTML = avatarOrLetter(currentUser.name, currentUser.avatar);
    document.getElementById('profileNameDisplay').textContent = currentUser.name;
    document.getElementById('profileEmoji').textContent = currentUser.tag_emoji || '';
    document.getElementById('profileHandleDisplay').textContent = currentUser.handle;
    document.getElementById('profileNameInput').value = currentUser.name;
    document.getElementById('profileHandleInput').value = currentUser.handle;
    // privacy toggles
    ['toggleViewPosts', 'toggleReactions', 'toggleComments'].forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const key = el.dataset.key;
      const on = currentUser[key] !== false;
      el.classList.toggle('on', on);
    });
    loadMyPosts();
  }

  function closeAllProfilePanels() {
    document.querySelectorAll('.profile-edit-panel').forEach(p => p.classList.remove('open'));
  }
  function toggleProfilePanel(id) {
    const panel = document.getElementById(id);
    const wasOpen = panel.classList.contains('open');
    closeAllProfilePanels();
    if (!wasOpen) panel.classList.add('open');
  }

  document.getElementById('editNamePencil').addEventListener('click', () => toggleProfilePanel('panelEditName'));
  document.getElementById('editHandlePencil').addEventListener('click', () => toggleProfilePanel('panelEditHandle'));
  document.getElementById('btnGeneralSettings').addEventListener('click', () => openSettingsModal());
  document.getElementById('btnReports')?.addEventListener('click', () => {
    openReportsList(!!(currentUser && currentUser.is_moderator));
  });
  document.getElementById('btnOpenPassword').addEventListener('click', () => toggleProfilePanel('panelPassword'));
  document.getElementById('btnOpenDelete').addEventListener('click', () => toggleProfilePanel('panelDelete'));

  // Privacy toggles
  document.querySelectorAll('.toggle-switch').forEach(el => {
    el.addEventListener('click', () => {
      const key = el.dataset.key;
      if (!key || !currentUser) return;
      const next = !el.classList.contains('on');
      el.classList.toggle('on', next);
      const body = { handle: currentUser.handle };
      body[key] = next;
      api('/profile/update', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      }).then(updated => { currentUser = updated; saveSession(); })
        .catch(err => { el.classList.toggle('on', !next); appAlert(friendlyError(err)); });
    });
  });

  const emojiPickerBtn = document.getElementById('emojiPickerBtn');
  const emojiPopup = document.getElementById('emojiPopup');
  emojiPickerBtn.addEventListener('click', () => emojiPopup.classList.toggle('show'));
  emojiPopup.querySelectorAll('span').forEach(span => {
    span.addEventListener('click', () => {
      const clearing = span.textContent.trim() === '❌';
      api('/profile/update', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ handle: currentUser.handle, clear_tag_emoji: clearing, new_tag_emoji: clearing ? '' : span.textContent })
      }).then(updated => { currentUser = updated; saveSession(); renderProfile(); }).catch(err => appAlert(friendlyError(err)));
      emojiPopup.classList.remove('show');
    });
  });

  document.getElementById('profileCopyIdBtn').addEventListener('click', () => {
    navigator.clipboard.writeText('@' + currentUser.handle).then(() => {
      const btn = document.getElementById('profileCopyIdBtn');
      const old = btn.textContent;
      btn.textContent = 'Скопировано ✓';
      setTimeout(() => { btn.textContent = old; }, 1500);
    });
  });

  document.getElementById('avatarFileInput').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const img = new Image();
    const reader = new FileReader();
    reader.onload = () => {
      img.onload = () => {
        const size = Math.min(img.width, img.height);
        const canvas = document.createElement('canvas');
        canvas.width = 300; canvas.height = 300;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, (img.width - size) / 2, (img.height - size) / 2, size, size, 0, 0, 300, 300);
        const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
        api('/profile/update', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ handle: currentUser.handle, new_avatar: dataUrl })
        }).then(updated => { currentUser = updated; saveSession(); renderProfile(); }).catch(err => appAlert(friendlyError(err)));
      };
      img.src = reader.result;
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  });

  document.getElementById('saveNameBtn').addEventListener('click', () => {
    const newName = document.getElementById('profileNameInput').value.trim();
    const hint = document.getElementById('saveNameHint');
    hint.style.color = '';
    if (newName.length < 2) { hint.textContent = 'Ім\'я закоротке'; hint.style.color = 'var(--err)'; return; }
    hint.textContent = 'Сохраняем...';
    api('/profile/update', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ handle: currentUser.handle, new_name: newName })
    }).then(updated => {
      currentUser = updated; saveSession(); renderProfile();
      hint.textContent = 'Сохранено ✓';
      setTimeout(() => { hint.textContent = ''; closeAllProfilePanels(); }, 1000);
    }).catch(err => { hint.textContent = friendlyError(err); hint.style.color = 'var(--err)'; });
  });

  document.getElementById('saveHandleBtn').addEventListener('click', () => {
    const newHandle = document.getElementById('profileHandleInput').value.trim().replace(/[^A-Za-z0-9_-]/g, '');
    const hint = document.getElementById('saveHandleHint');
    hint.style.color = '';
    if (newHandle.length < 3) { hint.textContent = 'Хендл слишком короткий'; hint.style.color = 'var(--err)'; return; }
    if (isReservedUserHandle(newHandle)) { hint.textContent = 'Хендл зарезервирован (voice/channel/groupe/chat)'; hint.style.color = 'var(--err)'; return; }
    hint.textContent = 'Сохраняем...';
    api('/profile/update', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ handle: currentUser.handle, new_handle: newHandle })
    }).then(updated => {
      currentUser = updated; saveSession(); renderProfile();
      hint.textContent = 'Сохранено ✓';
      setTimeout(() => { hint.textContent = ''; closeAllProfilePanels(); }, 1000);
    }).catch(err => { hint.textContent = friendlyError(err); hint.style.color = 'var(--err)'; });
  });

  // ---- Posts ----
  document.getElementById('postPhotoInput').addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const img = new Image();
    const reader = new FileReader();
    reader.onload = () => {
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const maxW = 800;
        let w = img.width, h = img.height;
        if (w > maxW) { h = Math.round(h * maxW / w); w = maxW; }
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        pendingPostPhoto = canvas.toDataURL('image/jpeg', 0.8);
        const prev = document.getElementById('postPhotoPreview');
        prev.src = pendingPostPhoto;
        prev.style.display = 'block';
      };
      img.src = reader.result;
    };
    reader.readAsDataURL(file);
    e.target.value = '';
  });

  document.getElementById('publishPostBtn').addEventListener('click', () => {
    const text = document.getElementById('postTextInput').value.trim().slice(0, 300);
    if (!text && !pendingPostPhoto) { appAlert('Додайте текст або фото'); return; }
    api('/posts/create', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ owner_handle: currentUser.handle, text, photo: pendingPostPhoto })
    }).then(() => {
      document.getElementById('postTextInput').value = '';
      pendingPostPhoto = '';
      document.getElementById('postPhotoPreview').style.display = 'none';
      loadMyPosts();
    }).catch(err => appAlert(friendlyError(err)));
  });

  function loadMyPosts() {
    if (!currentUser) return;
    api('/posts/' + encodeURIComponent(currentUser.handle) + '?viewer=' + encodeURIComponent(currentUser.handle))
      .then(data => {
        renderPostsList(document.getElementById('myPostsList'), data.posts || [], {
          isOwner: true,
          allowReactions: true,
          allowComments: true,
        });
      }).catch(() => {
        document.getElementById('myPostsList').innerHTML = '';
      });
  }

  function renderPostsList(container, posts, opts) {
    if (!posts.length) {
      container.innerHTML = `<div style="color:var(--text-muted);font-size:13px;padding:12px 0;text-align:center;">Пока нет постов</div>`;
      return;
    }
    let html = '';
    posts.forEach(p => {
      const counts = p.reaction_counts || {};
      const myR = p.my_reaction;
      let reactHtml = '';
      if (opts.allowReactions) {
        ['like', 'heart', 'dislike', 'fire'].forEach(key => {
          const cnt = counts[key] || 0;
          const active = myR === key ? ' active' : '';
          reactHtml += `<button class="post-react-btn${active}" onclick="toggleReaction('${p.post_id}','${key}', this)">${REACTION_MAP[key]}${cnt ? `<span class="cnt">${cnt}</span>` : ''}</button>`;
        });
      } else {
        // show counts only
        Object.keys(REACTION_MAP).forEach(key => {
          const cnt = counts[key] || 0;
          if (cnt) reactHtml += `<span class="post-react-btn" style="cursor:default;">${REACTION_MAP[key]}<span class="cnt">${cnt}</span></span>`;
        });
      }
      const delBtn = opts.isOwner
        ? `<button class="post-delete-btn" onclick="deletePost('${p.post_id}')"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg> Видалити</button>`
        : '';
      const commentBtn = `<button class="post-comment-btn" onclick="openComments('${p.post_id}', ${opts.allowComments}, ${opts.isOwner})"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5h-1L5 22l1.2-3.5A8.5 8.5 0 1 1 21 11.5z"/></svg> ${p.comments_count || 0}</button>`;
      html += `
      <div class="post-card" id="post-${p.post_id}">
        ${p.photo ? `<img class="post-photo" src="${p.photo}" alt="">` : ''}
        ${p.text ? `<div class="post-text">${escapeHtml(p.text)}</div>` : ''}
        <div class="post-actions">${reactHtml}${commentBtn}${delBtn}</div>
      </div>`;
    });
    container.innerHTML = html;
  }

  window.toggleReaction = function(postId, reaction, btn) {
    if (!currentUser) return;
    const isActive = btn.classList.contains('active');
    const endpoint = isActive ? '/posts/unreact' : '/posts/react';
    api(endpoint, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ post_id: postId, reactor_handle: currentUser.handle, reaction })
    }).then(res => {
      // refresh counts on the card
      const card = document.getElementById('post-' + postId);
      if (!card) return;
      const actions = card.querySelector('.post-actions');
      const counts = res.reaction_counts || {};
      const myR = res.my_reaction;
      let reactHtml = '';
      ['like', 'heart', 'dislike', 'fire'].forEach(key => {
        const cnt = counts[key] || 0;
        const active = myR === key ? ' active' : '';
        reactHtml += `<button class="post-react-btn${active}" onclick="toggleReaction('${postId}','${key}', this)">${REACTION_MAP[key]}${cnt ? `<span class="cnt">${cnt}</span>` : ''}</button>`;
      });
      // keep comment & delete buttons
      const commentBtn = actions.querySelector('.post-comment-btn');
      const delBtn = actions.querySelector('.post-delete-btn');
      actions.innerHTML = reactHtml + (commentBtn ? commentBtn.outerHTML : '') + (delBtn ? delBtn.outerHTML : '');
    }).catch(err => appAlert(friendlyError(err)));
  };

  window.deletePost = async function(postId) {
    const ok = await appConfirm('Удалить пост?', 'Удаление');
    if (!ok) return;
    api('/posts/delete', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ post_id: postId, requester_handle: currentUser.handle })
    }).then(() => {
      const el = document.getElementById('post-' + postId);
      if (el) el.remove();
      loadMyPosts();
    }).catch(err => appAlert(friendlyError(err)));
  };

  window.openComments = function(postId, allowComments, isOwner) {
    activeCommentsPostId = postId;
    activeCommentsAllow = allowComments;
    activeCommentsIsOwner = isOwner;
    document.getElementById('commentsOverlay').classList.add('show');
    document.getElementById('commentsComposer').style.display = allowComments ? 'flex' : 'none';
