  });

  const MAX_SECONDS = 240;
  let mediaRecorder = null, recordedChunks = [], recSeconds = 0, recTimerInterval = null, recStream = null;
  const micBtn = document.getElementById('micBtn');
  const recordingBar = document.getElementById('recordingBar');
  const composerBar = document.getElementById('composerBar');
  const recTimerEl = document.getElementById('recTimer');

  micBtn.addEventListener('click', startRecording);
  async function startRecording() {
    try { recStream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
    catch (err) { appAlert('Нужно разрешение на микрофон, чтобы записать голосовое сообщение.'); return; }

    recordedChunks = [];
    mediaRecorder = new MediaRecorder(recStream);
    mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) recordedChunks.push(e.data); };
    mediaRecorder.start();

    recSeconds = 0;
    recTimerEl.textContent = '0:00';
    recordingBar.classList.add('active');
    composerBar.style.display = 'none';

    recTimerInterval = setInterval(() => {
      recSeconds++;
      recTimerEl.textContent = Math.floor(recSeconds / 60) + ':' + String(recSeconds % 60).padStart(2, '0');
      if (recSeconds >= MAX_SECONDS) finishRecording(true);
    }, 1000);
  }

  document.getElementById('recCancelBtn').addEventListener('click', () => finishRecording(false));
  document.getElementById('recSendBtn').addEventListener('click', () => finishRecording(true));

  function finishRecording(send) {
    clearInterval(recTimerInterval);
    recordingBar.classList.remove('active');
    composerBar.style.display = 'flex';
    if (!mediaRecorder) return;
    const durationLabel = Math.floor(recSeconds / 60) + ':' + String(recSeconds % 60).padStart(2, '0');

    mediaRecorder.onstop = () => {
      if (recStream) recStream.getTracks().forEach(t => t.stop());
      if (!send || recordedChunks.length === 0) return;
      const blob = new Blob(recordedChunks, { type: 'audio/webm' });
      const reader = new FileReader();
      reader.onload = () => sendActiveMessage('voice', reader.result, durationLabel);
      reader.readAsDataURL(blob);
    };
    mediaRecorder.stop();
  }

