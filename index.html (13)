      <div id="resultReason"></div>
      <button class="primary" id="resultRetryBtn" style="display:none;">Попробовать ещё раз</button>
    </div>
  </div>

  <!-- ======================= MAIN APP SCREEN ======================= -->
  <div class="screen" id="screenApp">
