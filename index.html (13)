  function sendActiveMessage(type, content, duration) {
    if (!activeChat) return;
    const time = nowTime();
    const replyFields = pendingReply ? { reply_to: pendingReply.message_id, reply_preview: pendingReply.preview } : { reply_to: '', reply_preview: '' };

    let request;
    if (activeChat.kind === 'saved') {
      request = api('/saved/send', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ owner_handle: currentUser.handle, type, content, time, duration: duration || '', ...replyFields })
      });
    } else if (activeChat.kind === 'dm') {
      request = api('/messages/send', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ from_handle: currentUser.handle, to_handle: activeChat.handle, type, content, time, duration: duration || '', ...replyFields })
      });
    } else {
      request = api('/entities/messages/send', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entity_handle: activeChat.handle, from_handle: currentUser.handle, type, content, time, duration: duration || '', ...replyFields })
      });
    }

    clearReply();
    request.then(() => pollActiveChat(true)).catch(err => appAlert('Не удалось отправить: ' + friendlyError(err)));
  }

