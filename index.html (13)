  function wireCreateValidation(nameId, handleId, btnId) {
    const nameEl = document.getElementById(nameId);
    const handleEl = document.getElementById(handleId);
    const btn = document.getElementById(btnId);
    function sanitize() {
      handleEl.value = handleEl.value.replace(/[^A-Za-z0-9_-]/g, '');
      btn.disabled = !(nameEl.value.trim().length >= 2 && handleEl.value.length >= 2);
    }
    nameEl.addEventListener('input', sanitize);
    handleEl.addEventListener('input', sanitize);
  }
