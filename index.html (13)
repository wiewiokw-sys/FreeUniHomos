      <div class="profile-field">
        <label>Фон чата (видят все участники)</label>
        <div style="font-size:12px;color:var(--text-muted);margin-bottom:8px;">Рекомендуемый размер: <b>1080 × 1920</b> px (портрет). Фон общий — если кто-то поставит, увидят все в этом чате.</div>
        <input type="file" id="chatBgFile" accept="image/*">
        <div class="save-hint" id="chatBgHint" style="margin-top:6px;"></div>
        <button type="button" class="vol-save-btn" style="margin-top:8px;" id="chatBgClear">Сбросить фон</button>
      </div>
    `;
    if (activeChat.kind === 'entity' && activeChat.handle !== 'worldchat') {
      html += `
      <div class="profile-field">
        <label>Авто-удаление сообщений (сервер, 0 = выкл)</label>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          ${[0,1,3,5,10].map(m => `<button type="button" class="vol-save-btn" data-adm="${m}">${m === 0 ? 'Выкл' : m + ' мин'}</button>`).join('')}
        </div>
        <div style="font-size:12px;color:var(--text-muted);margin-top:6px;">Доступно создателю или модератору</div>
      </div>`;
    }
    body.innerHTML = html;
    modal.classList.add('show');
    applyChatBackground();
    document.getElementById('chatBgFile')?.addEventListener('change', (e) => {
      const f = e.target.files && e.target.files[0];
      if (!f) return;
      const hint = document.getElementById('chatBgHint');
      if (f.size > 2_500_000) {
        if (hint) { hint.textContent = 'Файл слишком большой (макс ~2.5 МБ)'; hint.style.color = 'var(--err)'; }
        return;
      }
      if (hint) { hint.textContent = 'Загрузка...'; hint.style.color = 'var(--text-muted)'; }
      const reader = new FileReader();
      reader.onload = () => {
        uploadChatBackground(reader.result)
          .then(() => { if (hint) { hint.textContent = 'Сохранено — видят все ✓'; hint.style.color = 'var(--ok)'; } })
          .catch(err => { if (hint) { hint.textContent = friendlyError(err); hint.style.color = 'var(--err)'; } });
      };
      reader.readAsDataURL(f);
    });
    document.getElementById('chatBgClear')?.addEventListener('click', () => {
      const hint = document.getElementById('chatBgHint');
      uploadChatBackground('__clear__')
        .then(() => { if (hint) { hint.textContent = 'Фон сброшен'; hint.style.color = 'var(--ok)'; } })
        .catch(err => { if (hint) { hint.textContent = friendlyError(err); hint.style.color = 'var(--err)'; } });
    });
    body.querySelectorAll('[data-adm]').forEach(btn => {
      btn.addEventListener('click', () => {
        const m = parseInt(btn.dataset.adm, 10);
        api('/entities/update', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ entity_handle: activeChat.handle, requester_handle: currentUser.handle, auto_delete_minutes: m })
        }).then(() => appAlert('Сохранено')).catch(err => appAlert(friendlyError(err)));
      });
    });
  }
  function setMessagesAreaBg(url) {
    const area = document.getElementById('messagesArea');
    if (!area) return;
    if (url) {
      area.style.backgroundImage = 'url(' + url + ')';
      area.style.backgroundSize = 'cover';
      area.style.backgroundPosition = 'center';
    } else {
      area.style.backgroundImage = '';
      area.style.backgroundSize = '';
      area.style.backgroundPosition = '';
    }
  }
  function applyChatBackground() {
    const area = document.getElementById('messagesArea');
    if (!area || !activeChat || !currentUser) return;
    let kind = activeChat.kind;
    let peer = activeChat.handle || '';
    if (kind === 'saved') peer = currentUser.handle;
    // entity uses handle; dm uses peer handle
    api('/chat/background?kind=' + encodeURIComponent(kind) +
        '&requester_handle=' + encodeURIComponent(currentUser.handle) +
        '&peer_handle=' + encodeURIComponent(peer)
    ).then(data => {
      if (!activeChat) return;
      setMessagesAreaBg(data.background || '');
    }).catch(() => setMessagesAreaBg(''));
  }
  function uploadChatBackground(dataUrl) {
    if (!activeChat || !currentUser) return Promise.reject(new Error('No chat'));
    let kind = activeChat.kind;
    let peer = activeChat.handle || '';
    if (kind === 'saved') peer = currentUser.handle;
    return api('/chat/background', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        requester_handle: currentUser.handle,
        kind,
        peer_handle: peer,
        background: dataUrl || '__clear__'
      })
    }).then(data => {
      setMessagesAreaBg(data.background || '');
      return data;
    });
  }
  // re-apply bg when opening chat
  const _openChatCommonOrig = openChatCommon;
  // already patched openChatCommon - hook apply at end via mutation

  if (currentUser) enterApp();
</script>
