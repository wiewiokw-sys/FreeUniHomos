    if (event) event.stopPropagation();
    const nameEl = document.getElementById(kind + 'Name');
    const handleEl = document.getElementById(kind + 'Handle');
    const name = nameEl.value.trim();
    const handle = handleEl.value.trim();
    if (name.length < 2 || handle.length < 2) return;

    api('/entities/create', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ kind, name, handle, creator_handle: currentUser.handle })
    }).then(entity => {
      nameEl.value = ''; handleEl.value = '';
      toggleCreateForm(null);
      refreshChatList();
      if (kind === 'voice') {
        openEntityByHandle(entity.handle, 'voice');
        refreshVoiceList();
