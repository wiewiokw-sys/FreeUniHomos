  function forwardTo(kind, handle, name) {
    document.getElementById('forwardOverlay').style.display = 'none';
    if (!forwardMessage) return;
    const time = nowTime();
    const body = { type: forwardMessage.type, content: forwardMessage.content, time, duration: forwardMessage.duration || '', forwarded_from: forwardMessage.from_handle || currentUser.handle };
    let request;
    if (kind === 'saved') {
      request = api('/saved/send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ owner_handle: currentUser.handle, ...body }) });
    } else if (kind === 'dm') {
      request = api('/messages/send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ from_handle: currentUser.handle, to_handle: handle, ...body }) });
    } else {
      request = api('/entities/messages/send', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ entity_handle: handle, from_handle: currentUser.handle, ...body }) });
    }
    request.then(() => {
      if (activeChat && activeChat.kind === kind && activeChat.handle === handle) pollActiveChat(true);
    }).catch(err => appAlert(friendlyError(err)));
  }

  // ---------------------------------------------------------------
